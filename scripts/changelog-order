#!/usr/bin/env python3
"""scripts/changelog-order — prove every branch's changelog entry is present, resolvable, and
readable in merge order, and assemble the branch-by-branch history for a person to read.

Run it from anywhere inside the repository:

    scripts/changelog-order              # check this working tree
    scripts/changelog-order check <path> # check some other copy of the ARCHIVE file — a
                                         # `git show` of an older tree, say, which is how a
                                         # finding count is quoted as evidence and re-derived
                                         # by a reviewer. The two directories are still read
                                         # from this checkout.
    scripts/changelog-order read         # the whole branch-by-branch history, in order, on
                                         # stdout — pipe it to a pager
    scripts/changelog-order manual-tests # the whole manual-test checklist, in order
    scripts/changelog-order selftest     # re-prove every arm still fires

Exit 0 clean, 2 findings, 1 when no trustworthy measurement was made — a run that cannot
resolve a mainline, finds local `main` and `origin/main` diverged, cannot find `## Entries`, or
maps no merge at all reports that rather than printing a reassuring zero. A search whose engine
cannot see the bytes you mean answers a clean zero, and a clean zero is the one answer that
looks like good news (CLAUDE.md, Claims and evidence).

ONE FILE PER BRANCH (SONNY-500). A branch writes its entry at `docs/changelog/<branch>.md` and
its manual-test rows at `docs/manual-tests/<branch>.md`, a slash in the branch name becoming a
folder exactly as `mutation/plans/` already does. Two branches therefore never write to one
file, which is the whole reason this exists: across wave 9's thirteen branches no code
conflicted anywhere — 0 of 44 differing paths on PR #244, 0 of 34 on PR #250, 0 of 3 on PR #248
— and every conflict in the wave was one of two documents every branch inserted into.

WHAT THAT DID TO THIS TOOL'S JOB, which is unchanged from a reader's point of view. Order used
to be a property of where an entry sat in a file, and this checked it. With one file per branch
there is no position to get wrong: the order is each branch's merge commit, and `read` derives
it rather than checking it. What replaces the ordering arm is a completeness arm — a branch that
merged and wrote no entry is now the fault that a misplaced entry used to be, and it is just as
quiet, because nothing else in this repository ever goes red on a missing record.

THE ARCHIVE. `docs/sonny-v1-implementation-changelog.md` keeps every word it had and takes no
new entries; `docs/sonny-manual-test-checklist.md` likewise. Splitting them was the other
option and was not taken — see this branch's own entry for why. The archive is frozen, so its
ordering arms below can never go red on honest work again, and they are kept for the one thing
that can still happen: a session appending an entry to it out of habit. That is the exact fault
they were written for, and it raises no rebase conflict either.

WHERE THE NEW ERA BEGINS. `DIRECTORY_ERA_BRANCH` below names the branch whose merge starts it.
Every branch merging at or after that point owes a file in each directory; everything merged
before it is the archive's and is not checked for completeness — about thirty branches merged
before this rule existed and wrote no entry, some of them rightly (WORKFLOW.md step 7 names
which, and why no back-entries were written). Before that branch merges the era is empty and the
completeness arm has nothing to say, which is a clean zero, so every run prints what it resolved
the boundary to. A boundary that never resolves — the branch renamed, say — would switch the arm
off silently otherwise.

WHICH MAINLINE. The merge log is read from whichever of local `main` and `origin/main`
contains the other, and every run prints which one it read and its SHA, on the line beginning
`changelog-order: mainline is`, so a reading can be told apart from a stale one. It never
fetches. `resolve_mainline` below has the reason (SONNY-480).

THE ARCHIVE'S TWO ERAS. That file is newest-first from `feature/vision-actions` (PR #50) upward
and oldest-first from PR #3 up to PR #49 below it, the two runs meeting exactly at that entry.
That is deliberate and documented in the changelog's own Entry Template preamble; moving the
older run would create a defect rather than fix one. So the boundary is named here, and its
entry's absence is itself a finding — a check that silently loses its boundary would pass a
file it can no longer read.
"""

from __future__ import annotations

import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
from typing import NamedTuple

CHANGELOG = "docs/sonny-v1-implementation-changelog.md"
CHECKLIST = "docs/sonny-manual-test-checklist.md"
ENTRY_DIR = "docs/changelog"
MANUAL_DIR = "docs/manual-tests"
ENTRIES_MARKER = "## Entries"
HEADING = "### Branch: "
STATUS = "Status:"

# The one filename in either directory that is not a branch's file. It is skipped by exact
# name at the directory's root and nowhere else, so `docs/changelog/feature/README.md` would
# still be read as an entry for a branch called `feature/README` — which is a name nothing
# creates, and the alternative is a rule that quietly hides a real file.
DIRECTORY_README = "README.md"

# The branch whose merge starts the one-file-per-branch era. Every branch merging at or after
# it owes `docs/changelog/<branch>.md` and `docs/manual-tests/<branch>.md`.
DIRECTORY_ERA_BRANCH = "chore/an-entry-is-a-file-of-its-own"

# The entry where the archive's two eras meet. Everything at or above it is newest-first;
# everything below it is oldest-first. See the changelog's Entry Template preamble.
ERA_BOUNDARY = "feature/vision-actions"

MERGE_RE = re.compile(r"^Merge pull request #(\d+) from [^/]+/(.+)$")
class Unmeasurable(Exception):
    """Raised when the run cannot produce a trustworthy answer. Never a silent zero."""


def repo_root() -> str:
    out = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                         capture_output=True, text=True)
    if out.returncode != 0:
        raise Unmeasurable("not inside a git repository: " + out.stderr.strip())
    return out.stdout.strip()


class Mainline(NamedTuple):
    """The commit a run reads the merge log from, and what the other candidate said."""
    ref: str   # "main" or "origin/main"
    sha: str   # the full commit id; the log is read from this, never from the ref, so the SHA
               # a run prints and the history it measured cannot come apart
    note: str  # why this one, in words a reader can check

    def line(self) -> str:
        return "changelog-order: mainline is %s at %s — %s." % (self.ref, self.sha[:8], self.note)


def _commit(cwd: str, ref: str) -> str | None:
    probe = subprocess.run(["git", "rev-parse", "--verify", "--quiet", ref + "^{commit}"],
                           capture_output=True, text=True, cwd=cwd)
    return probe.stdout.strip() if probe.returncode == 0 else None


def _holds(cwd: str, newer: str, older: str) -> bool:
    """Whether `older` is an ancestor of `newer`. Exit 1 is a plain no; anything else is git
    failing, which must not be read as either answer."""
    r = subprocess.run(["git", "merge-base", "--is-ancestor", older, newer],
                       capture_output=True, text=True, cwd=cwd)
    if r.returncode not in (0, 1):
        raise Unmeasurable("git merge-base --is-ancestor %s %s failed: %s"
                           % (older[:8], newer[:8], r.stderr.strip()))
    return r.returncode == 0


def _count(cwd: str, older: str, newer: str, first_parent: bool) -> int:
    """How many commits `newer` has that `older` lacks."""
    r = subprocess.run(["git", "rev-list", "--count"] + (["--first-parent"] if first_parent else [])
                       + [older + ".." + newer], capture_output=True, text=True, cwd=cwd)
    if r.returncode != 0:
        raise Unmeasurable("git rev-list --count %s..%s failed: %s"
                           % (older[:8], newer[:8], r.stderr.strip()))
    return int(r.stdout.strip())


def _commits(n: int, noun: str = "commit") -> str:
    return "%d %s%s" % (n, noun, "" if n == 1 else "s")


def _behind(cwd: str, older: str, newer: str) -> str:
    return "%s behind it" % _commits(_count(cwd, older, newer, first_parent=True),
                                     "first-parent commit")


def resolve_mainline(cwd: str) -> Mainline:
    """The fresher of local `main` and `origin/main`, or a refusal when neither holds the other.

    This used to read local `main` whenever it existed and `origin/main` only when it did not,
    and that produced false findings (SONNY-480). Every worktree shares one local `main`. A merge
    on GitHub does not move it, and neither does a fetch, which moves only `origin/main` — so
    between a merge and somebody's pull, `main` names a commit from before that merge while
    `origin/main` holds it, and every entry merged since read as unmerged. Whichever of the two
    contains the other has seen every merge the other has, so that one is read. Two that have
    diverged — a local commit on `main`, or a clone from before a history rewrite — have no
    fresher side, and picking one would be a guess printed as a measurement.

    This never fetches. `origin/main` is as fresh as this clone's last fetch, so the answer is
    the freshest mainline this clone holds, not necessarily GitHub's; the SHA every run prints
    is what lets a reader tell the two apart.
    """
    local = _commit(cwd, "main")
    remote = _commit(cwd, "origin/main")
    if local is None and remote is None:
        raise Unmeasurable("no mainline ref resolves (tried: main, origin/main)")
    if remote is None:
        return Mainline("main", local, "there is no origin/main in this clone to compare it with")
    if local is None:
        return Mainline("origin/main", remote, "there is no local main in this clone")
    if local == remote:
        return Mainline("main", local, "origin/main is the same commit")
    if _holds(cwd, remote, local):
        return Mainline("origin/main", remote, "local main at %s is %s, so it was not read"
                        % (local[:8], _behind(cwd, local, remote)))
    if _holds(cwd, local, remote):
        return Mainline("main", local, "origin/main at %s is %s, so it was not read"
                        % (remote[:8], _behind(cwd, remote, local)))
    # Diverged: local `main` holds commits `origin/main` does not, and they may be somebody's
    # work. So the refusal says that and gives a command that only reads them, and no advice to
    # move a ref. The old "bring local main level with origin/main", followed literally, is a
    # reset that discards them (PR #243's review, R2). The count and the command come first
    # because the stop hook quotes a refusal only as far as `cut -c1-200` reaches.
    mine = _count(cwd, remote, local, first_parent=False)
    theirs = _count(cwd, local, remote, first_parent=False)
    raise Unmeasurable(
        "local main has %s origin/main lacks, so the two have diverged. See %s, read-only: "
        "git log --oneline origin/main..main (local main %s, origin/main %s, which has %s local "
        "main lacks). Nothing was measured and no ref was moved"
        % (_commits(mine), "it" if mine == 1 else "them", local[:8], remote[:8],
           _commits(theirs)))


def merge_index(mainline: Mainline, cwd: str) -> dict[str, tuple[int, int]]:
    """branch name -> (index on the mainline oldest-first, PR number).

    A branch that merged more than once keeps its latest merge, which is the position the
    entry describes.
    """
    out = subprocess.run(["git", "log", "--first-parent", "--merges", "--format=%s", mainline.sha],
                         capture_output=True, text=True, cwd=cwd)
    if out.returncode != 0:
        raise Unmeasurable("git log failed on %s: %s" % (mainline.ref, out.stderr.strip()))

    subjects = list(reversed(out.stdout.splitlines()))  # oldest first
    index: dict[str, tuple[int, int]] = {}
    for position, subject in enumerate(subjects):
        m = MERGE_RE.match(subject)
        if m:
            index[m.group(2)] = (position, int(m.group(1)))
    if not index:
        raise Unmeasurable("parsed no 'Merge pull request #N from <ns>/<branch>' subject "
                           "out of %d merge commits on %s" % (len(subjects), mainline.ref))
    return index


def entries(text: str) -> list[tuple[int, str, list[str]]]:
    """(1-based heading line, branch name, the lines of its body) for each entry under
    `## Entries`, in file order."""
    lines = text.split("\n")
    try:
        start = next(i for i, l in enumerate(lines) if l.rstrip() == ENTRIES_MARKER)
    except StopIteration:
        raise Unmeasurable("no %r line in the changelog — the template's own example heading "
                           "sits above it, so without this marker every check would be "
                           "measuring the template too" % ENTRIES_MARKER)
    heads = [i for i in range(start + 1, len(lines)) if lines[i].startswith(HEADING)]
    if not heads:
        raise Unmeasurable("no %r heading under %r" % (HEADING, ENTRIES_MARKER))
    out = []
    for n, i in enumerate(heads):
        end = heads[n + 1] if n + 1 < len(heads) else len(lines)
        out.append((i + 1, lines[i][len(HEADING):].strip(), lines[i + 1:end]))
    return out


def ref_branches(cwd: str) -> set[str]:
    """Every branch name this clone holds a ref for, local or remote-tracking.

    It is what separates the two unresolvable-entry faults from each other. An entry naming a
    branch with a ref but no merge is work that has not landed — the branch under review is
    exactly that shape, which is why one of them is allowed. An entry naming a name with no ref
    anywhere and no merge is a typo or a rename nobody followed, and is never allowed.

    Refs are enumerated and matched by name rather than probed with `git rev-parse <branch>`,
    because that resolves `refs/remotes/<branch>` and not `refs/remotes/<remote>/<branch>` — so
    a branch that exists only on the remote, which is every branch in a fresh clone, would read
    as not existing at all.
    """
    out = subprocess.run(["git", "for-each-ref", "--format=%(refname)",
                          "refs/heads", "refs/remotes"],
                         capture_output=True, text=True, cwd=cwd)
    if out.returncode != 0:
        raise Unmeasurable("git for-each-ref failed: " + out.stderr.strip())
    names: set[str] = set()
    for ref in out.stdout.splitlines():
        if ref.startswith("refs/heads/"):
            names.add(ref[len("refs/heads/"):])
        elif ref.startswith("refs/remotes/"):
            rest = ref[len("refs/remotes/"):]
            if "/" in rest:
                remote, branch = rest.split("/", 1)
                if branch != "HEAD":
                    names.add(branch)
    return names


class DirEntry(NamedTuple):
    """One branch's file in one of the two directories."""
    path: str     # repo-relative, e.g. docs/changelog/chore/a-name.md
    branch: str   # the path with its directory and `.md` stripped: chore/a-name
    lines: list[str]


def directory_entries(cwd: str, directory: str) -> tuple[list[DirEntry], list[str]]:
    """Every branch file under `directory`, plus findings about files that are not one.

    A missing directory is zero files rather than a refusal. Before the era boundary merges
    that is the honest state, and after it the completeness arm below turns a deleted
    directory into a finding per missing entry, which names what is gone instead of refusing
    to measure anything at all.
    """
    root = os.path.join(cwd, directory)
    found: list[DirEntry] = []
    findings: list[str] = []
    if not os.path.isdir(root):
        return found, findings
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames.sort()
        for name in sorted(filenames):
            full = os.path.join(dirpath, name)
            rel = os.path.relpath(full, cwd)
            if os.path.dirname(rel) == directory and name == DIRECTORY_README:
                continue
            if not name.endswith(".md"):
                # Silently skipping it is the clean zero this repository keeps being caught
                # by: the file is plainly somebody's entry, and nothing would ever read it.
                findings.append(
                    "%s: not a .md file, so nothing under %s reads it as a branch's file — "
                    "rename it to <branch>.md or move it out of this directory"
                    % (rel, directory))
                continue
            with open(full, encoding="utf-8") as fh:
                text = fh.read()
            branch = rel[len(directory) + 1:-len(".md")]
            found.append(DirEntry(rel, branch, text.split("\n")))
    found.sort(key=lambda e: e.path)
    return found, findings


def _structure(where: str, line: int, branch: str, body: list[str]) -> list[str]:
    """Exactly one `Status:` line per entry. Zero is a heading with no entry under it; two is
    an entry whose own heading no line-anchored search can see, because a lost newline glued it
    to the line above."""
    n = sum(1 for l in body if l.startswith(STATUS))
    if n == 1:
        return []
    return ["%s:%d: entry %r has %d %r lines between its heading and the next, expected 1 — %s"
            % (where, line, branch, n, STATUS,
               "a heading with no entry beneath it" if n == 0 else
               "an entry whose heading is not at the start of its own line, or a duplicated "
               "heading")]


def check(path: str, cwd: str, mainline: Mainline | None = None,
          index: dict[str, tuple[int, int]] | None = None,
          entry_dir: str = ENTRY_DIR, manual_dir: str = MANUAL_DIR) -> list[str]:
    # Findings name the file that was read, never the constant — in the selftest they are
    # different files, and a finding that names a file nobody checked is not evidence.
    where = os.path.relpath(path, cwd) if path.startswith(cwd) else path
    with open(path, encoding="utf-8") as fh:
        text = fh.read()
    archive = entries(text)
    if index is None:
        index = merge_index(mainline or resolve_mainline(cwd), cwd)
    refs = ref_branches(cwd)
    findings: list[str] = []

    entry_files, entry_findings = directory_entries(cwd, entry_dir)
    manual_files, manual_findings = directory_entries(cwd, manual_dir)
    findings.extend(entry_findings)
    findings.extend(manual_findings)

    # Arm 1 — structure, in the archive and in each entry file alike.
    for line, branch, body in archive:
        findings.extend(_structure(where, line, branch, body))
    for entry in entry_files:
        heads = [i for i, l in enumerate(entry.lines) if l.startswith(HEADING)]
        if len(heads) != 1:
            findings.append(
                "%s: has %d %r headings, expected exactly 1 — one file is one entry, and a "
                "file holding two entries hides one of them from every count"
                % (entry.path, len(heads), HEADING.strip()))
            continue
        named = entry.lines[heads[0]][len(HEADING):].strip()
        if named != entry.branch:
            # The path is what every other arm reads, so a heading that disagrees with it is an
            # entry filed under one branch and describing another — the shape a copied entry
            # takes, and one nothing else here could see.
            findings.append(
                "%s:%d: the heading names %r and the path names %r — an entry's heading and "
                "its filename are the same branch, or one of the two is somebody else's"
                % (entry.path, heads[0] + 1, named, entry.branch))
        findings.extend(_structure(entry.path, heads[0] + 1, entry.branch,
                                   entry.lines[heads[0] + 1:]))

    # Arm 2 — resolvable. Every entry, in the archive or in the directory, names a branch that
    # merged on the mainline. Two faults hide under that one sentence and they are told apart
    # by whether the name has a ref at all:
    #
    #   * a ref but no merge — work that has not landed. Exactly one entry may be this, and it
    #     is the branch being worked on: WORKFLOW.md step 7 has the entry written and committed
    #     before the PR opens, so on the branch under review its own entry names no merge yet.
    #     Without that allowance the check would be red on every branch that writes an entry,
    #     which is how a check becomes one people learn to skip (CLAUDE.md, SONNY-64).
    #   * no ref and no merge — a typo, or a branch renamed after its entry was written. Never
    #     allowed, at any count, because it cannot be the branch anyone is standing on.
    #
    # The allowance is a count rather than a position or a `git rev-parse HEAD` reading, so it
    # gives the same answer in a lane, in a reviewer's detached worktree and in a fresh clone.
    unmerged: list[tuple[str, str]] = []   # (where, branch)
    positioned = []
    for line, branch, _ in archive:
        if branch in index:
            positioned.append(("%s:%d" % (where, line), branch) + index[branch])
        elif branch in refs:
            unmerged.append(("%s:%d" % (where, line), branch))
        else:
            findings.append(
                "%s:%d: entry %r names a branch that does not exist — no 'Merge pull request "
                "#N from <ns>/%s' on the mainline, and no local or remote-tracking ref of that "
                "name in this clone" % (where, line, branch, branch))
    for entry in entry_files:
        if entry.branch in index:
            continue
        if entry.branch in refs:
            unmerged.append((entry.path, entry.branch))
        else:
            findings.append(
                "%s: names a branch that does not exist — no 'Merge pull request #N from "
                "<ns>/%s' on the mainline, and no local or remote-tracking ref of that name in "
                "this clone" % (entry.path, entry.branch))
    for manual in manual_files:
        if manual.branch in index or manual.branch in refs:
            continue
        findings.append(
            "%s: names a branch that does not exist — no 'Merge pull request #N from "
            "<ns>/%s' on the mainline, and no local or remote-tracking ref of that name in "
            "this clone" % (manual.path, manual.branch))
    if len(unmerged) > 1:
        findings.append(
            "%d entries name a branch that has not merged, and only one may — %s. On a branch "
            "cut from main that is one entry, its own; a short stack of two or three carries "
            "this finding until each merge clears it, which is its expected cost (WORKFLOW.md, "
            "Stacked pull requests)."
            % (len(unmerged), ", ".join("%s (%s)" % (w, b) for w, b in unmerged)))

    # Arm 3 — completeness, over the one-file-per-branch era only. Everything merged before the
    # boundary is the archive's, and about thirty of those branches wrote no entry at all.
    era = index.get(DIRECTORY_ERA_BRANCH)
    if era is None:
        # The boundary has not merged. That makes this arm vacuous, which is a clean zero, so
        # the one state that would keep it vacuous forever — the constant gone stale because
        # the branch was renamed — is caught by its own symptom: entries for branches that
        # merged after a boundary that never resolves.
        merged_entries = sorted(e.branch for e in entry_files if e.branch in index)
        if merged_entries:
            findings.append(
                "the one-file-per-branch era's boundary %r has not merged, yet %d entry file(s) "
                "name branches that have — %s. Either that constant in this script is stale "
                "(the branch was renamed) or those entries were written before the rule "
                "existed; nothing is being checked for completeness until it resolves."
                % (DIRECTORY_ERA_BRANCH, len(merged_entries), ", ".join(merged_entries)))
    else:
        era_position = era[0]
        have_entries = {e.branch for e in entry_files}
        have_manual = {m.branch for m in manual_files}
        for branch, (position, pr) in sorted(index.items(), key=lambda kv: kv[1][0]):
            if position < era_position:
                continue
            for directory, have in ((entry_dir, have_entries), (manual_dir, have_manual)):
                if branch not in have:
                    findings.append(
                        "%s/%s.md: missing — PR #%d merged %r at mainline position %d, in the "
                        "one-file-per-branch era, and every branch that merges in it writes "
                        "this file. A branch that owes nothing writes one line saying so; a "
                        "missing file and a deliberate 'none' are the same silence otherwise."
                        % (directory, branch, pr, branch, position))

    # Arm 4 — the archive's order, per era. It takes no new entries, so this can no longer go
    # red on honest work; what it still catches is an entry appended to it out of habit, which
    # raises no rebase conflict and would otherwise be found by nothing.
    boundary = [i for i, e in enumerate(positioned) if e[1] == ERA_BOUNDARY]
    if not boundary:
        findings.append(
            "%s: the era boundary %r has no entry, so the two eras cannot be told apart — "
            "this check cannot run over this file until that is resolved (see the "
            "changelog's Entry Template preamble)" % (where, ERA_BOUNDARY))
        return findings
    split = boundary[0]
    newest_first = positioned[:split + 1]
    oldest_first = positioned[split + 1:]

    for a, b in zip(newest_first, newest_first[1:]):
        if not a[2] > b[2]:
            findings.append(
                "%s: PR #%d (mainline position %d) is above PR #%d (position %d), and this "
                "run of the file is newest-first — %r belongs above %r"
                % (a[0], a[3], a[2], b[3], b[2], b[1], a[1]))
    # The oldest-first run is a closed historical range: it ends where the boundary entry
    # begins, so every entry in it merged before the boundary did. Without this, an entry
    # appended at the file's end — the exact mistake five entries have made, and a quiet one
    # because nobody else writes there and it raises no rebase conflict — lands at the bottom
    # of that run with the highest index of all and satisfies "increasing" perfectly. The
    # selftest found that hole in this check's first draft rather than a reader finding it in
    # a year (SONNY-329).
    for at, branch, position, pr in oldest_first:
        if position > newest_first[-1][2]:
            findings.append(
                "%s: PR #%d (mainline position %d) sits below %r, in the run that ends at "
                "PR #%d — an entry that merged after the boundary belongs in the newest-first "
                "run at the top of the file, not appended at its end"
                % (at, pr, position, ERA_BOUNDARY, newest_first[-1][3]))
    for a, b in zip(oldest_first, oldest_first[1:]):
        if not a[2] < b[2]:
            findings.append(
                "%s: PR #%d (mainline position %d) is above PR #%d (position %d), and the "
                "run below %r is oldest-first — %r belongs above %r"
                % (a[0], a[3], a[2], b[3], b[2], ERA_BOUNDARY, b[1], a[1]))
    return findings


# --------------------------------------------------------------------------------------
# read / manual-tests — the one way to read the history in order
# --------------------------------------------------------------------------------------

def reading_order(files: list[DirEntry], index: dict[str, tuple[int, int]]) -> list[DirEntry]:
    """Newest first: whatever has not merged yet, then every merged branch by its merge,
    latest first. Unmerged files sort by path so the answer does not depend on the filesystem."""
    unmerged = sorted((f for f in files if f.branch not in index), key=lambda f: f.path)
    merged = sorted((f for f in files if f.branch in index),
                    key=lambda f: index[f.branch][0], reverse=True)
    return unmerged + merged


def assemble(cwd: str, mainline: Mainline, directory: str, archive_rel: str,
             from_marker: bool) -> str:
    """Every branch's file in merge order, then the archive it continues, as one stream.

    This is what keeps one file per branch from costing a reader the one document they used to
    open. `from_marker` prints the archive from `## Entries` down, which is the changelog's
    history proper — its roadmap and template preamble sit above that line and are not history.
    """
    index = merge_index(mainline, cwd)
    files, _ = directory_entries(cwd, directory)
    ordered = reading_order(files, index)
    out = [mainline.line(),
           "changelog-order: %d file(s) under %s, newest first, then %s."
           % (len(ordered), directory, archive_rel), ""]
    for f in ordered:
        at = index.get(f.branch)
        out.append("<!-- %s — %s -->"
                   % (f.path, "PR #%d, mainline position %d" % (at[1], at[0]) if at
                      else "not merged yet"))
        out.append("\n".join(f.lines).rstrip("\n"))
        out.append("")
    archive_path = os.path.join(cwd, archive_rel)
    with open(archive_path, encoding="utf-8") as fh:
        text = fh.read()
    if from_marker:
        lines = text.split("\n")
        try:
            start = next(i for i, l in enumerate(lines) if l.rstrip() == ENTRIES_MARKER)
        except StopIteration:
            raise Unmeasurable("no %r line in %s, so the archive's history cannot be found"
                               % (ENTRIES_MARKER, archive_rel))
        text = "\n".join(lines[start:])
    out.append("<!-- %s — the archive, everything before the one-file-per-branch era -->"
               % archive_rel)
    out.append(text.rstrip("\n"))
    return "\n".join(out)


def era_line(index: dict[str, tuple[int, int]]) -> str:
    """What the completeness arm resolved its boundary to, printed on every run.

    A boundary that stops resolving switches that arm off without any output changing, which is
    the clean-zero failure this repository keeps being caught by. So the resolution is stated
    rather than assumed, on every run, clean or not.
    """
    era = index.get(DIRECTORY_ERA_BRANCH)
    if era is None:
        return ("changelog-order: the one-file-per-branch era has not begun — %r is not on the "
                "mainline, so no branch is checked for a missing file yet."
                % DIRECTORY_ERA_BRANCH)
    return ("changelog-order: the one-file-per-branch era begins at PR #%d (%s), mainline "
            "position %d — every branch merging at or after it owes %s/<branch>.md and "
            "%s/<branch>.md." % (era[1], DIRECTORY_ERA_BRANCH, era[0], ENTRY_DIR, MANUAL_DIR))


# --------------------------------------------------------------------------------------
# selftest
# --------------------------------------------------------------------------------------

GOOD_ENTRY = "### Branch: %s\nStatus: complete\nDate: 2026-01-01\n\nbody\n"


def _git(cwd: str, *args: str) -> str:
    r = subprocess.run(("git",) + args, cwd=cwd, capture_output=True, text=True)
    if r.returncode != 0:
        raise SystemExit("selftest: git %s failed: %s" % (" ".join(args), r.stderr.strip()))
    return r.stdout.strip()


def _point_mainline_refs(repo: str, main: str | None, origin: str | None) -> None:
    """Set the fixture's local `main` and its `origin/main` to the given commits, None deleting
    the ref. HEAD is detached first, so moving or deleting `main` never moves a checkout."""
    _git(repo, "checkout", "-q", "--detach")
    for name, sha in (("refs/heads/main", main), ("refs/remotes/origin/main", origin)):
        if sha is None:
            if subprocess.run(["git", "rev-parse", "--verify", "--quiet", name],
                              cwd=repo, capture_output=True).returncode == 0:
                _git(repo, "update-ref", "-d", name)
        else:
            _git(repo, "update-ref", name, sha)


def _fixture_repo(tmp: str, merges: list[tuple[int, str]], unmerged: list[str] = ()) -> str:
    """A repository whose mainline holds one merge per (PR number, branch), in list order,
    plus a ref for each branch in `unmerged` that has no merge at all — the shape a branch
    under review has, and the thing that tells a typo apart from work that has not landed."""
    _git(tmp, "init", "-q", "-b", "main")
    _git(tmp, "config", "user.email", "selftest@example.invalid")
    _git(tmp, "config", "user.name", "selftest")
    open(os.path.join(tmp, "seed"), "w").write("seed\n")
    _git(tmp, "add", "seed")
    _git(tmp, "commit", "-q", "-m", "seed")
    for pr, branch in merges:
        _git(tmp, "checkout", "-q", "-b", branch)
        open(os.path.join(tmp, branch.replace("/", "_")), "w").write("x\n")
        _git(tmp, "add", "-A")
        _git(tmp, "commit", "-q", "-m", "work on " + branch)
        _git(tmp, "checkout", "-q", "main")
        _git(tmp, "merge", "-q", "--no-ff", "-m",
             "Merge pull request #%d from ns/%s" % (pr, branch), branch)
    for branch in unmerged:
        _git(tmp, "branch", branch, "main")
    return tmp


def _write(tmp: str, entry_branches: list[str], mangle=None) -> str:
    body = ENTRIES_MARKER + "\n\n" + "\n".join(GOOD_ENTRY % b for b in entry_branches)
    if mangle:
        body = mangle(body)
    path = os.path.join(tmp, "changelog.md")
    open(path, "w", encoding="utf-8").write("# fixture\n\n" + body)
    return path


def _put(repo: str, directory: str, branch: str, text: str, suffix: str = ".md") -> str:
    """Write one branch's file into one of the fixture's directories."""
    path = os.path.join(repo, directory, branch + suffix)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    open(path, "w", encoding="utf-8").write(text)
    return path


def _clear(repo: str) -> None:
    for directory in (ENTRY_DIR, MANUAL_DIR):
        shutil.rmtree(os.path.join(repo, directory), ignore_errors=True)


def _full(repo: str, branches: list[str]) -> None:
    """Both directories populated for every branch named — the state a clean era is in."""
    for branch in branches:
        _put(repo, ENTRY_DIR, branch, GOOD_ENTRY % branch)
        _put(repo, MANUAL_DIR, branch, "# %s\n\nNo rows owed.\n" % branch)


def selftest() -> int:
    # Mainline order: PR #3 .. #5 (the archive's oldest-first era), the archive's era boundary,
    # then #51 .. #53. `this/branch` and `also/unmerged` have refs and no merge.
    merges = [(3, "old/a"), (4, "old/b"), (5, "old/c"), (50, ERA_BOUNDARY),
              (51, "new/a"), (52, "new/b"), (53, "new/c")]
    # In-file order: newest-first down to the boundary, then oldest-first below it.
    good = ["new/c", "new/b", "new/a", ERA_BOUNDARY, "old/a", "old/b", "old/c"]
    loose = ["this/branch", "also/unmerged"]

    cases: list[tuple[str, object, object, str]] = []

    def case(name, entry_branches, mangle, expect):
        cases.append((name, entry_branches, mangle, expect))

    case("an archive in order passes", good, None, "")
    case("a newest-first entry out of order is caught",
         ["new/b", "new/c", "new/a", ERA_BOUNDARY, "old/a", "old/b", "old/c"], None,
         "belongs above")
    case("an oldest-first entry out of order is caught",
         ["new/c", "new/b", "new/a", ERA_BOUNDARY, "old/b", "old/a", "old/c"], None,
         "oldest-first")
    case("an entry appended at the archive's end is caught",
         ["new/c", "new/b", ERA_BOUNDARY, "old/a", "old/b", "old/c", "new/a"], None,
         "not appended at its end")
    case("one unmerged entry — the branch's own — passes",
         ["this/branch"] + good, None, "")
    case("FAULT 1: a second unmerged entry is caught",
         ["this/branch"] + good + ["also/unmerged"], None,
         "name a branch that has not merged, and only one may")
    case("FAULT 3: an entry naming a branch that does not exist is caught",
         good + ["never/existed"], None,
         "names a branch that does not exist")
    case("  ...and it is caught even when it is the only unmerged entry",
         ["never/existed"] + good, None,
         "names a branch that does not exist")
    case("a bodiless heading is caught", good,
         lambda b: b.replace("### Branch: new/b", "### Branch: stray/heading\n\n### Branch: new/b"),
         "has 0 'Status:' lines")
    case("a heading glued to the previous line by a lost newline is caught", good,
         lambda b: b.replace("body\n\n### Branch: new/b", "body### Branch: new/b"),
         "has 2 'Status:' lines")
    case("the archive's era boundary going missing stops the check rather than passing it",
         [b for b in good if b != ERA_BOUNDARY], None,
         "era boundary")

    with tempfile.TemporaryDirectory() as tmp:
        repo = _fixture_repo(os.path.join(tmp, "repo") if os.makedirs(
            os.path.join(tmp, "repo"), exist_ok=True) is None else tmp, merges, loose)
        failures = 0
        for name, entry_branches, mangle, expect in cases:
            path = _write(tmp, entry_branches, mangle)
            try:
                findings = check(path, repo)
            except Unmeasurable as exc:
                print("  FAIL  %s — the check refused to measure: %s" % (name, exc))
                failures += 1
                continue
            if expect == "":
                ok = not findings
            else:
                ok = any(expect in f for f in findings)
            print("  %s  %s" % ("ok  " if ok else "FAIL", name))
            if not ok:
                failures += 1
                for f in findings:
                    print("        got: " + f)
                if expect:
                    print("        expected a finding containing: " + expect)
        ran = len(cases)

        # ----------------------------------------------------------------------------------
        # The directories. Everything above ran with neither of them present, which is the
        # state before the era begins and is itself one of the arms below.
        # ----------------------------------------------------------------------------------
        def dir_case(name, expect, build):
            nonlocal failures, ran
            ran += 1
            _clear(repo)
            build()
            try:
                findings = check(_write(tmp, good), repo)
            except Unmeasurable as exc:
                print("  FAIL  %s — the check refused to measure: %s" % (name, exc))
                failures += 1
                return
            ok = (not findings) if expect == "" else any(expect in f for f in findings)
            print("  %s  %s" % ("ok  " if ok else "FAIL", name))
            if not ok:
                failures += 1
                for f in findings:
                    print("        got: " + f)
                if expect:
                    print("        expected a finding containing: " + expect)

        dir_case("an entry file for the branch being worked on passes", "",
                 lambda: _full(repo, ["this/branch"]))
        dir_case("FAULT 1: an entry file for a branch that never merged, beside another, "
                 "is caught", "name a branch that has not merged, and only one may",
                 lambda: _full(repo, ["this/branch", "also/unmerged"]))
        dir_case("FAULT 3: an entry file named for a branch that does not exist is caught",
                 "names a branch that does not exist",
                 lambda: _full(repo, ["never/existed"]))
        dir_case("  ...and so is a manual-test file named for one",
                 "docs/manual-tests/never/existed.md: names a branch that does not exist",
                 lambda: _put(repo, MANUAL_DIR, "never/existed", "# rows\n"))
        dir_case("an entry whose heading names a different branch is caught",
                 "the heading names 'new/a' and the path names 'this/branch'",
                 lambda: (_full(repo, ["this/branch"]),
                          _put(repo, ENTRY_DIR, "this/branch", GOOD_ENTRY % "new/a")))
        dir_case("an entry file holding two entries is caught",
                 "has 2 '### Branch:' headings",
                 lambda: (_full(repo, ["this/branch"]),
                          _put(repo, ENTRY_DIR, "this/branch",
                               (GOOD_ENTRY % "this/branch") + "\n" + (GOOD_ENTRY % "new/a"))))
        dir_case("an entry file with no Status line is caught", "has 0 'Status:' lines",
                 lambda: (_full(repo, ["this/branch"]),
                          _put(repo, ENTRY_DIR, "this/branch",
                               "### Branch: this/branch\nDate: 2026-01-01\n\nbody\n")))
        dir_case("a file that is not .md is caught rather than skipped",
                 "not a .md file",
                 lambda: _put(repo, ENTRY_DIR, "this/branch", "x\n", suffix=".txt"))
        dir_case("a README at a directory's root is not read as a branch's file", "",
                 lambda: (_full(repo, ["this/branch"]),
                          _put(repo, ENTRY_DIR, "README", "# how to write one\n"),
                          _put(repo, MANUAL_DIR, "README", "# how to write one\n")))
        # The stale-boundary guard: the era's own branch has not merged in this fixture, so an
        # entry naming a branch that HAS merged is the symptom of a renamed boundary.
        dir_case("an entry for a merged branch, with the boundary unresolved, is caught",
                 "has not merged, yet 1 entry file(s) name branches that have",
                 lambda: _full(repo, ["new/a"]))
        _clear(repo)

        # ----------------------------------------------------------------------------------
        # The era, resolved. A second fixture whose mainline merges the boundary branch itself,
        # then two more branches after it — every one of which owes both files.
        # ----------------------------------------------------------------------------------
        era_repo = os.path.join(tmp, "era")
        os.makedirs(era_repo, exist_ok=True)
        _fixture_repo(era_repo, merges + [(54, DIRECTORY_ERA_BRANCH), (55, "wave/one"),
                                          (56, "wave/two")], loose)
        era_archive = os.path.join(tmp, "era-changelog.md")
        shutil.copy(_write(tmp, good), era_archive)

        def era_case(name, expect, build):
            nonlocal failures, ran
            ran += 1
            _clear(era_repo)
            build()
            try:
                findings = check(era_archive, era_repo)
            except Unmeasurable as exc:
                print("  FAIL  %s — the check refused to measure: %s" % (name, exc))
                failures += 1
                return
            ok = (not findings) if expect == "" else any(expect in f for f in findings)
            print("  %s  %s" % ("ok  " if ok else "FAIL", name))
            if not ok:
                failures += 1
                for f in findings:
                    print("        got: " + f)
                if expect:
                    print("        expected a finding containing: " + expect)

        era_all = [DIRECTORY_ERA_BRANCH, "wave/one", "wave/two"]
        era_case("every branch in the era carrying both files passes, and branches merged "
                 "before it owe nothing", "", lambda: _full(era_repo, era_all))
        era_case("FAULT 2: a merged branch with no entry file is caught",
                 "docs/changelog/wave/two.md: missing — PR #56 merged 'wave/two'",
                 lambda: _full(era_repo, [DIRECTORY_ERA_BRANCH, "wave/one"]))
        era_case("  ...and a merged branch with no manual-test file is caught too",
                 "docs/manual-tests/wave/two.md: missing",
                 lambda: (_full(era_repo, era_all),
                          os.remove(os.path.join(era_repo, MANUAL_DIR, "wave/two.md"))))
        era_case("deleting the whole directory names every entry it lost, rather than refusing",
                 "docs/changelog/wave/one.md: missing",
                 lambda: _full(era_repo, []))
        ran += 1
        era_index = merge_index(resolve_mainline(era_repo), era_repo)
        if ("begins at PR #54" in era_line(era_index)
                and "has not begun" in era_line(merge_index(resolve_mainline(repo), repo))):
            print("  ok    every run says what it resolved the era boundary to, either way")
        else:
            print("  FAIL  the era line does not state the boundary both ways\n"
                  "        got: %s | %s" % (era_line(era_index),
                                            era_line(merge_index(resolve_mainline(repo), repo))))
            failures += 1

        # ----------------------------------------------------------------------------------
        # `read` — the one way a person reads the history in order. It must carry every file,
        # newest first, and the archive behind them.
        # ----------------------------------------------------------------------------------
        _clear(era_repo)
        _full(era_repo, era_all + ["this/branch"])
        ran += 1
        text = assemble(era_repo, resolve_mainline(era_repo), ENTRY_DIR, era_archive,
                        from_marker=True)
        order = [l for l in text.split("\n") if l.startswith("<!-- docs/changelog/")]
        want = ["<!-- docs/changelog/this/branch.md — not merged yet -->",
                "<!-- docs/changelog/wave/two.md — PR #56, mainline position 9 -->",
                "<!-- docs/changelog/wave/one.md — PR #55, mainline position 8 -->"]
        if order[:3] == want and "### Branch: wave/two" in text and ENTRIES_MARKER in text:
            print("  ok    `read` prints every file newest first, unmerged first, then the "
                  "archive")
        else:
            print("  FAIL  `read` did not assemble in merge order\n        got: %s"
                  % order[:3])
            failures += 1

        # A `read` that silently loses files is the clean zero this whole tool is against, so
        # the count it prints is checked against what is on disk.
        ran += 1
        if "4 file(s) under docs/changelog" in text:
            print("  ok    `read` says how many files it assembled")
        else:
            print("  FAIL  `read` did not count the files it assembled\n        got: %s"
                  % text.split("\n")[1])
            failures += 1

        # ----------------------------------------------------------------------------------
        # `check <path>` must actually read that path. An argument silently ignored would
        # check the repository's own changelog — here the fixture's, which does not exist — and
        # never report the findings of the file it was handed; a finding count quoted as
        # evidence would then be a measurement of the wrong file. Run through the real command
        # line, not through check(), and inside the fixture rather than this checkout: this
        # checkout's own `main` and `origin/main` can legitimately have diverged, which is a
        # refusal (exit 1), and this arm is not about which mainline gets read.
        # ----------------------------------------------------------------------------------
        _clear(repo)
        bad = _write(tmp, ["new/b", "new/c", "new/a", ERA_BOUNDARY, "old/a", "old/b", "old/c"])
        proc = subprocess.run([sys.executable, os.path.abspath(__file__), "check", bad],
                              capture_output=True, text=True, cwd=repo)
        named = os.path.basename(bad) in proc.stdout and "new/c" in proc.stdout
        ran += 1
        if proc.returncode == 2 and named:
            print("  ok    `check <path>` reads the path it is given")
        else:
            print("  FAIL  `check <path>` did not read the path it is given "
                  "(exit %d, named=%s)" % (proc.returncode, named))
            failures += 1
        # The same run with findings names its mainline, above the first finding (PR #243's
        # review, F1). This is the run the stop hook shows when it blocks, and the one where a
        # stale mainline would show as findings, so it is where the line matters most.
        out = proc.stdout.splitlines()
        line_at = next((i for i, l in enumerate(out)
                        if l.startswith("changelog-order: mainline is main at %s"
                                        % _git(repo, "rev-parse", "main")[:8])), None)
        finding_at = next((i for i, l in enumerate(out) if os.path.basename(bad) in l), None)
        ran += 1
        if proc.returncode == 2 and None not in (line_at, finding_at) and line_at < finding_at:
            print("  ok    a run with findings prints the mainline line above them")
        else:
            print("  FAIL  a run with findings did not print the mainline line above them "
                  "(exit %d, mainline line at %s, first finding at %s)\n        got: %s"
                  % (proc.returncode, line_at, finding_at, proc.stdout.strip()))
            failures += 1

        # A refusal rather than a clean zero, proved rather than asserted.
        empty = os.path.join(tmp, "empty.md")
        open(empty, "w").write("# nothing here\n")
        for name, path, cwd in (("a file with no '## Entries' refuses", empty, repo),
                                ("a directory that is not a repository refuses",
                                 _write(tmp, good), tempfile.gettempdir())):
            ran += 1
            try:
                check(path, cwd)
            except Unmeasurable as exc:
                print("  ok    %s (%s)" % (name, str(exc).split("\n")[0][:60]))
            else:
                print("  FAIL  %s — it returned an answer instead" % name)
                failures += 1

        # Which mainline is read (SONNY-480). Every worktree shares one local `main`, and nothing
        # moves it when a pull request merges on GitHub, so between a merge and somebody's pull
        # it names a commit from before that merge while `origin/main` already holds it. Read
        # first, a stale `main` reports every entry merged since as unmerged — a false finding
        # that reads exactly like a real one, and the stop hook blocks a turn on it.
        # tip is #53's merge; tip~2 is #51's, the last merge a stale `main` would still hold.
        tip = _git(repo, "rev-parse", "main")
        behind = _git(repo, "rev-parse", "main~2")
        # A commit on `main` that `origin/main` does not hold, and the reverse: diverged.
        stray = _git(repo, "commit-tree", behind + "^{tree}", "-p", behind, "-m", "local only")
        # (name, local main, origin/main, the ref that must be read or None for a refusal,
        #  what the note or the refusal must say)
        refs_cases = [
            ("a local main behind origin/main is not what gets measured",
             behind, tip, "origin/main", ["local main at %s" % behind[:8], "2 first-parent"]),
            ("a local main ahead of origin/main is what gets measured",
             tip, behind, "main", ["origin/main at %s" % behind[:8], "2 first-parent"]),
            ("main and origin/main at one commit measure clean",
             tip, tip, "main", ["the same commit"]),
            ("origin/main alone, with no local main, is measured",
             None, tip, "origin/main", ["no local main"]),
            ("a local main diverged from origin/main refuses rather than picking one",
             stray, tip, None, ["have diverged", stray[:8], tip[:8]]),
        ]
        for name, main_sha, origin_sha, want_ref, says in refs_cases:
            _point_mainline_refs(repo, main_sha, origin_sha)
            path = _write(tmp, good)
            ran += 1
            try:
                mainline = resolve_mainline(repo)
                findings = check(path, repo, mainline)
            except Unmeasurable as exc:
                text = str(exc)
                ok = want_ref is None and all(w in text for w in says)
                detail = "refused: %s" % text
            else:
                ok = (want_ref == mainline.ref and mainline.sha == (
                          origin_sha if want_ref == "origin/main" else main_sha)
                      and not findings and all(w in mainline.note for w in says))
                detail = "read %s; %s" % (mainline.line(),
                                          "; ".join(findings) or "measured clean")
            print("  %s  %s" % ("ok  " if ok else "FAIL", name))
            if not ok:
                failures += 1
                print("        got: " + detail)
                print("        expected: %s, saying %s" % (want_ref or "a refusal", says))

        # The mainline and its SHA are printed on every run, through the real command line —
        # a reading that does not say what it read cannot be told apart from a stale one. And a
        # refusal puts its reason first, because the stop hook keeps only the head of it.
        _point_mainline_refs(repo, behind, tip)
        proc = subprocess.run([sys.executable, os.path.abspath(__file__), "check",
                               _write(tmp, good)], capture_output=True, text=True, cwd=repo)
        want = "changelog-order: mainline is origin/main at %s — local main at %s" % (
            tip[:8], behind[:8])
        ran += 1
        if proc.returncode == 0 and want in proc.stdout:
            print("  ok    a clean run prints the mainline it read and its SHA")
        else:
            print("  FAIL  a clean run did not print %r (exit %d)\n        got: %s"
                  % (want, proc.returncode, (proc.stdout + proc.stderr).strip()))
            failures += 1
        ran += 1
        if proc.returncode == 0 and "the one-file-per-branch era has not begun" in proc.stdout:
            print("  ok    a clean run prints the era boundary it resolved")
        else:
            print("  FAIL  a clean run did not print the era line (exit %d)\n        got: %s"
                  % (proc.returncode, proc.stdout.strip()))
            failures += 1
        _point_mainline_refs(repo, stray, tip)
        proc = subprocess.run([sys.executable, os.path.abspath(__file__), "check",
                               _write(tmp, good)], capture_output=True, text=True, cwd=repo)
        first = (proc.stderr.splitlines() or [""])[0]
        ran += 1
        if proc.returncode == 1 and "have diverged" in first and proc.stdout == "":
            print("  ok    a diverged mainline exits 1 with its reason on the first line")
        else:
            print("  FAIL  a diverged mainline did not refuse cleanly (exit %d)\n        got: %s"
                  % (proc.returncode, (proc.stdout + proc.stderr).strip()))
            failures += 1
        # What the stop hook shows of that refusal is its output flattened to one line and cut
        # at `cut -c1-200`. Measured in bytes, which is never more than characters, so the
        # check holds whichever of the two that `cut` counts in. What has to survive the cut:
        # that local `main` holds a commit `origin/main` lacks, and a command that only reads
        # it (PR #243's review, R2).
        quoted = (proc.stdout + proc.stderr).replace("\n", " ").replace("\t", " ")
        quoted = quoted.encode("utf-8")[:200].decode("utf-8", "ignore")
        ran += 1
        wanted = ("local main has 1 commit origin/main lacks",
                  "git log --oneline origin/main..main")
        if all(w in quoted for w in wanted):
            print("  ok    a diverged refusal's reason and read-only command fit the hook's "
                  "quote")
        else:
            print("  FAIL  the hook's 200-byte quote of a diverged refusal lacks %s\n"
                  "        got: %s" % ([w for w in wanted if w not in quoted], quoted))
            failures += 1
        # A git failure inside the ancestry check is not divergence (PR #243's review, R4). Both
        # refuse with exit 1, so only the words tell them apart, and "diverged" would send the
        # reader to inspect commits that are not the problem. A `git` placed first on PATH fails
        # `merge-base` alone and hands every other subcommand to the real one, so the run gets as
        # far as the ancestry check and no further.
        fake_bin = os.path.join(tmp, "fake-git-bin")
        os.makedirs(fake_bin, exist_ok=True)
        fake_git = os.path.join(fake_bin, "git")
        with open(fake_git, "w") as fh:
            fh.write('#!/bin/sh\nif [ "$1" = merge-base ]; then\n'
                     '  echo "fatal: the selftest made merge-base fail" >&2; exit 128\nfi\n'
                     'exec %s "$@"\n' % shlex.quote(shutil.which("git") or "git"))
        os.chmod(fake_git, 0o755)
        _point_mainline_refs(repo, behind, tip)
        fake_path = fake_bin + os.pathsep + os.environ.get("PATH", "")
        proc = subprocess.run([sys.executable, os.path.abspath(__file__), "check",
                               _write(tmp, good)], capture_output=True, text=True, cwd=repo,
                              env=dict(os.environ, PATH=fake_path))
        first = (proc.stderr.splitlines() or [""])[0]
        ran += 1
        if (proc.returncode == 1 and "git merge-base --is-ancestor" in first
                and "the selftest made merge-base fail" in first and "diverged" not in proc.stderr):
            print("  ok    a git failure in the ancestry check is refused as that failure")
        else:
            print("  FAIL  a git failure in the ancestry check was not refused as itself "
                  "(exit %d)\n        got: %s" % (proc.returncode, proc.stderr.strip()))
            failures += 1

        # A refusal that comes after the mainline resolved still names it — on the line after
        # the reason, never before it.
        _point_mainline_refs(repo, tip, None)
        proc = subprocess.run([sys.executable, os.path.abspath(__file__), "check", empty],
                              capture_output=True, text=True, cwd=repo)
        lines = proc.stderr.splitlines()
        ran += 1
        if (proc.returncode == 1 and len(lines) == 2 and "## Entries" in lines[0]
                and lines[1].startswith("changelog-order: mainline is main at %s" % tip[:8])):
            print("  ok    a refusal after the mainline resolved gives its reason, then the "
                  "mainline")
        else:
            print("  FAIL  a refusal after the mainline resolved was not reason-then-mainline "
                  "(exit %d)\n        got: %s" % (proc.returncode, proc.stderr.strip()))
            failures += 1

    print("selftest: %d case(s), %d failure(s)" % (ran, failures))
    return 0 if failures == 0 else 2


USAGE = "usage: scripts/changelog-order [check [<path>] | read | manual-tests | selftest]"


def main(argv: list[str]) -> int:
    args = [a for a in argv[1:] if not a.startswith("-")]
    if args and args[0] == "selftest":
        return selftest()
    if args and args[0] not in ("check", "read", "manual-tests"):
        print(__doc__)
        if args[0] in ("help", "--help"):
            return 0
        print(USAGE, file=sys.stderr)
        return 1
    command = args[0] if args else "check"
    mainline = None
    try:
        root = repo_root()
        # `check <path>` reads some other copy of the archive — an older tree written out with
        # `git show`, most usefully — against this repository's merge log. The default is the
        # working tree's own. Ordering is a property of the file *and* the mainline, so the
        # log always comes from the repository this is run in, and so do the two directories.
        path = os.path.abspath(args[1]) if command == "check" and len(args) > 1 \
            else os.path.join(root, CHANGELOG)
        mainline = resolve_mainline(root)
        if command == "read":
            print(assemble(root, mainline, ENTRY_DIR, CHANGELOG, from_marker=True))
            return 0
        if command == "manual-tests":
            print(assemble(root, mainline, MANUAL_DIR, CHECKLIST, from_marker=False))
            return 0
        index = merge_index(mainline, root)
        findings = check(path, root, mainline, index=index)
    except Unmeasurable as exc:
        # The reason first: the stop hook quotes a refusal only as far as `cut -c1-200` reaches.
        print("changelog-order: no measurement was made — %s" % exc, file=sys.stderr)
        if mainline is not None:
            print(mainline.line(), file=sys.stderr)
        return 1
    print(mainline.line())
    print(era_line(index))
    if findings:
        for f in findings:
            print(f)
        print("\n%d finding(s). docs/changelog/README.md states where an entry goes and what "
              "it owes; WORKFLOW.md step 7 is the process around it." % len(findings),
              file=sys.stderr)
        return 2
    shown = os.path.relpath(path, root) if path.startswith(root) else path
    entry_files, _ = directory_entries(root, ENTRY_DIR)
    manual_files, _ = directory_entries(root, MANUAL_DIR)
    print("changelog-order: %d entry file(s) under %s and %d under %s resolve, and %s's %d "
          "archived entries are in merge order across both its eras."
          % (len(entry_files), ENTRY_DIR, len(manual_files), MANUAL_DIR, shown,
             len(entries(open(path, encoding='utf-8').read()))))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
