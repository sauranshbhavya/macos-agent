#!/usr/bin/env python3
"""scripts/changelog-order — prove the changelog's entries are in merge order, and that each
one is an entry rather than a fragment of one.

Run it from anywhere inside the repository:

    scripts/changelog-order              # check the working tree's changelog
    scripts/changelog-order check <path> # check some other copy of it — a `git show` of an
                                         # older tree, say, which is how a finding count is
                                         # quoted as evidence and re-derived by a reviewer
    scripts/changelog-order selftest     # re-prove every arm still fires

Exit 0 clean, 2 findings, 1 when no trustworthy measurement was made — a run that cannot
resolve a mainline, finds local `main` and `origin/main` diverged, cannot find `## Entries`, or
maps no entry at all reports that rather than printing a reassuring zero. A search whose engine
cannot see the bytes you mean answers a clean zero, and a clean zero is the one answer that
looks like good news (CLAUDE.md, Claims and evidence).

WHY THIS EXISTS. An entry written into the wrong place raises no rebase conflict — nobody
else is editing that spot — so the clean merge is the tell, and five misplaced entries were
recorded before anything checked. Three more defects at the same boundary were found by hand
on 2026-08-29 (SONNY-329) and none of them is an ordering defect at all, which is why the
structural arm is here beside the ordering one: a heading glued to the end of the previous
entry's last line by a lost newline, a bodiless second copy of that same heading added two
positions away by a later branch, and a figure in prose that no command had ever answered.

WHICH MAINLINE. The merge log is read from whichever of local `main` and `origin/main`
contains the other, and every run prints which one it read and its SHA, on the line beginning
`changelog-order: mainline is`, so a reading can be told apart from a stale one. It never
fetches. `resolve_mainline` below has the reason (SONNY-480).

THE TWO ERAS. The file is newest-first from `feature/vision-actions` (PR #50) upward and
oldest-first from PR #3 up to PR #49 below it, the two runs meeting exactly at that entry.
That is deliberate and documented in the changelog's own Entry Template preamble; moving the
older run would create a defect rather than fix one. So the boundary is named here, and its
entry's absence is itself a finding — a check that silently loses its boundary would pass a
file it can no longer read.
"""

from __future__ import annotations

import os
import re
import subprocess
import sys
import tempfile
from typing import NamedTuple

CHANGELOG = "docs/sonny-v1-implementation-changelog.md"
ENTRIES_MARKER = "## Entries"
HEADING = "### Branch: "
STATUS = "Status:"

# The entry where the file's two eras meet. Everything at or above it is newest-first;
# everything below it is oldest-first. See the changelog's Entry Template preamble.
ERA_BOUNDARY = "feature/vision-actions"

MERGE_RE = re.compile(r"^Merge pull request #(\d+) from [^/]+/(.+)$")


class Unmeasurable(Exception):
    """Raised when the run cannot produce a trustworthy answer. Never a silent zero."""


def repo_root() -> str:
    out = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                         capture_output=True, text=True)
    if out.returncode != 0:
        raise Unmeasurable("not inside a git repository: " + out.stderr.strip())
    return out.stdout.strip()


class Mainline(NamedTuple):
    """The commit a run reads the merge log from, and what the other candidate said."""
    ref: str   # "main" or "origin/main"
    sha: str   # the full commit id; the log is read from this, never from the ref, so the SHA
               # a run prints and the history it measured cannot come apart
    note: str  # why this one, in words a reader can check

    def line(self) -> str:
        return "changelog-order: mainline is %s at %s — %s." % (self.ref, self.sha[:8], self.note)


def _commit(cwd: str, ref: str) -> str | None:
    probe = subprocess.run(["git", "rev-parse", "--verify", "--quiet", ref + "^{commit}"],
                           capture_output=True, text=True, cwd=cwd)
    return probe.stdout.strip() if probe.returncode == 0 else None


def _holds(cwd: str, newer: str, older: str) -> bool:
    """Whether `older` is an ancestor of `newer`. Exit 1 is a plain no; anything else is git
    failing, which must not be read as either answer."""
    r = subprocess.run(["git", "merge-base", "--is-ancestor", older, newer],
                       capture_output=True, text=True, cwd=cwd)
    if r.returncode not in (0, 1):
        raise Unmeasurable("git merge-base --is-ancestor %s %s failed: %s"
                           % (older[:8], newer[:8], r.stderr.strip()))
    return r.returncode == 0


def _behind(cwd: str, older: str, newer: str) -> str:
    r = subprocess.run(["git", "rev-list", "--count", "--first-parent", older + ".." + newer],
                       capture_output=True, text=True, cwd=cwd)
    if r.returncode != 0:
        raise Unmeasurable("git rev-list --count %s..%s failed: %s"
                           % (older[:8], newer[:8], r.stderr.strip()))
    n = int(r.stdout.strip())
    return "%d first-parent commit%s behind it" % (n, "" if n == 1 else "s")


def resolve_mainline(cwd: str) -> Mainline:
    """The fresher of local `main` and `origin/main`, or a refusal when neither holds the other.

    This used to read local `main` whenever it existed and `origin/main` only when it did not,
    and that produced false findings (SONNY-480). Every worktree shares one local `main`. A merge
    on GitHub does not move it, and neither does a fetch, which moves only `origin/main` — so
    between a merge and somebody's pull, `main` names a commit from before that merge while
    `origin/main` holds it, and every entry merged since read as unmerged. Whichever of the two
    contains the other has seen every merge the other has, so that one is read. Two that have
    diverged — a local commit on `main`, or a clone from before a history rewrite — have no
    fresher side, and picking one would be a guess printed as a measurement.

    This never fetches. `origin/main` is as fresh as this clone's last fetch, so the answer is
    the freshest mainline this clone holds, not necessarily GitHub's; the SHA every run prints
    is what lets a reader tell the two apart.
    """
    local = _commit(cwd, "main")
    remote = _commit(cwd, "origin/main")
    if local is None and remote is None:
        raise Unmeasurable("no mainline ref resolves (tried: main, origin/main)")
    if remote is None:
        return Mainline("main", local, "there is no origin/main in this clone to compare it with")
    if local is None:
        return Mainline("origin/main", remote, "there is no local main in this clone")
    if local == remote:
        return Mainline("main", local, "origin/main is the same commit")
    if _holds(cwd, remote, local):
        return Mainline("origin/main", remote, "local main at %s is %s, so it was not read"
                        % (local[:8], _behind(cwd, local, remote)))
    if _holds(cwd, local, remote):
        return Mainline("main", local, "origin/main at %s is %s, so it was not read"
                        % (remote[:8], _behind(cwd, remote, local)))
    raise Unmeasurable(
        "local main (%s) and origin/main (%s) have diverged — neither contains the other, so "
        "neither is the fresher mainline. Bring local main level with origin/main, then run "
        "this again" % (local[:8], remote[:8]))


def merge_index(mainline: Mainline, cwd: str) -> dict[str, tuple[int, int]]:
    """branch name -> (index on the mainline oldest-first, PR number).

    A branch that merged more than once keeps its latest merge, which is the position the
    entry describes.
    """
    out = subprocess.run(["git", "log", "--first-parent", "--merges", "--format=%s", mainline.sha],
                         capture_output=True, text=True, cwd=cwd)
    if out.returncode != 0:
        raise Unmeasurable("git log failed on %s: %s" % (mainline.ref, out.stderr.strip()))

    subjects = list(reversed(out.stdout.splitlines()))  # oldest first
    index: dict[str, tuple[int, int]] = {}
    for position, subject in enumerate(subjects):
        m = MERGE_RE.match(subject)
        if m:
            index[m.group(2)] = (position, int(m.group(1)))
    if not index:
        raise Unmeasurable("parsed no 'Merge pull request #N from <ns>/<branch>' subject "
                           "out of %d merge commits on %s" % (len(subjects), mainline.ref))
    return index


def entries(text: str) -> list[tuple[int, str, list[str]]]:
    """(1-based heading line, branch name, the lines of its body) for each entry under
    `## Entries`, in file order."""
    lines = text.split("\n")
    try:
        start = next(i for i, l in enumerate(lines) if l.rstrip() == ENTRIES_MARKER)
    except StopIteration:
        raise Unmeasurable("no %r line in the changelog — the template's own example heading "
                           "sits above it, so without this marker every check would be "
                           "measuring the template too" % ENTRIES_MARKER)
    heads = [i for i in range(start + 1, len(lines)) if lines[i].startswith(HEADING)]
    if not heads:
        raise Unmeasurable("no %r heading under %r" % (HEADING, ENTRIES_MARKER))
    out = []
    for n, i in enumerate(heads):
        end = heads[n + 1] if n + 1 < len(heads) else len(lines)
        out.append((i + 1, lines[i][len(HEADING):].strip(), lines[i + 1:end]))
    return out


def check(path: str, cwd: str, mainline: Mainline | None = None) -> list[str]:
    # Findings name the file that was read, never the constant — in the selftest they are
    # different files, and a finding that names a file nobody checked is not evidence.
    where = os.path.relpath(path, cwd) if path.startswith(cwd) else path
    with open(path, encoding="utf-8") as fh:
        text = fh.read()
    found = entries(text)
    index = merge_index(mainline or resolve_mainline(cwd), cwd)
    findings: list[str] = []

    # Arm 1 — structure. Exactly one Status: line between one heading and the next. Zero is a
    # heading with no entry under it; two is an entry whose own heading no line-anchored
    # search can see, because a lost newline glued it to the line above.
    for line, branch, body in found:
        n = sum(1 for l in body if l.startswith(STATUS))
        if n != 1:
            findings.append(
                "%s:%d: entry %r has %d %r lines between its heading and the next, expected 1 — "
                "%s" % (where, line, branch, n, STATUS,
                        "a heading with no entry beneath it" if n == 0 else
                        "an entry whose heading is not at the start of its own line, or a "
                        "duplicated heading"))

    # Arm 2 — resolvable. An entry naming a branch that never merged is a finding of its own:
    # it may be a typo, or an entry written for a branch that has not landed.
    # The one entry allowed to name no merge is the first, and only the first: step 7 has the
    # branch write its entry before the PR opens, so on the branch under review the newest
    # entry is by construction not on the mainline yet. Any other unmatched entry is a typo, a
    # renamed branch, or an entry for work that never landed. Without this exemption the check
    # would be red on every branch that writes an entry, which is how a check becomes one
    # people learn to skip — the failure this tool exists to avoid (CLAUDE.md, SONNY-64).
    positioned = []
    for n, (line, branch, _) in enumerate(found):
        if branch not in index:
            if n == 0:
                continue
            findings.append(
                "%s:%d: entry %r matches no 'Merge pull request #N from <ns>/%s' on the "
                "mainline, and it is not the first entry — only the newest may be unmerged, "
                "because step 7 writes it before the PR opens"
                % (where, line, branch, branch))
        else:
            positioned.append((line, branch) + index[branch])

    # Arm 3 — order, per era.
    boundary = [i for i, e in enumerate(positioned) if e[1] == ERA_BOUNDARY]
    if not boundary:
        findings.append(
            "%s: the era boundary %r has no entry, so the two eras cannot be told apart — "
            "this check cannot run over this file until that is resolved (see the "
            "changelog's Entry Template preamble)" % (where, ERA_BOUNDARY))
        return findings
    split = boundary[0]
    newest_first = positioned[:split + 1]
    oldest_first = positioned[split + 1:]

    for a, b in zip(newest_first, newest_first[1:]):
        if not a[2] > b[2]:
            findings.append(
                "%s:%d: PR #%d (mainline position %d) is above PR #%d (position %d), and this "
                "run of the file is newest-first — %r belongs above %r"
                % (where, a[0], a[3], a[2], b[3], b[2], b[1], a[1]))
    # The oldest-first run is a closed historical range: it ends where the boundary entry
    # begins, so every entry in it merged before the boundary did. Without this, an entry
    # appended at the file's end — the exact mistake five entries have made, and a quiet one
    # because nobody else writes there and it raises no rebase conflict — lands at the bottom
    # of that run with the highest index of all and satisfies "increasing" perfectly. The
    # selftest found that hole in this check's first draft rather than a reader finding it in
    # a year (SONNY-329).
    for line, branch, position, pr in oldest_first:
        if position > newest_first[-1][2]:
            findings.append(
                "%s:%d: PR #%d (mainline position %d) sits below %r, in the run that ends at "
                "PR #%d — an entry that merged after the boundary belongs in the newest-first "
                "run at the top of the file, not appended at its end"
                % (where, line, pr, position, ERA_BOUNDARY, newest_first[-1][3]))
    for a, b in zip(oldest_first, oldest_first[1:]):
        if not a[2] < b[2]:
            findings.append(
                "%s:%d: PR #%d (mainline position %d) is above PR #%d (position %d), and the "
                "run below %r is oldest-first — %r belongs above %r"
                % (where, a[0], a[3], a[2], b[3], b[2], ERA_BOUNDARY, b[1], a[1]))
    return findings


# --------------------------------------------------------------------------------------
# selftest
# --------------------------------------------------------------------------------------

GOOD_ENTRY = "### Branch: %s\nStatus: complete\nDate: 2026-01-01\n\nbody\n"


def _git(cwd: str, *args: str) -> str:
    r = subprocess.run(("git",) + args, cwd=cwd, capture_output=True, text=True)
    if r.returncode != 0:
        raise SystemExit("selftest: git %s failed: %s" % (" ".join(args), r.stderr.strip()))
    return r.stdout.strip()


def _point_mainline_refs(repo: str, main: str | None, origin: str | None) -> None:
    """Set the fixture's local `main` and its `origin/main` to the given commits, None deleting
    the ref. HEAD is detached first, so moving or deleting `main` never moves a checkout."""
    _git(repo, "checkout", "-q", "--detach")
    for name, sha in (("refs/heads/main", main), ("refs/remotes/origin/main", origin)):
        if sha is None:
            if subprocess.run(["git", "rev-parse", "--verify", "--quiet", name],
                              cwd=repo, capture_output=True).returncode == 0:
                _git(repo, "update-ref", "-d", name)
        else:
            _git(repo, "update-ref", name, sha)


def _fixture_repo(tmp: str, merges: list[tuple[int, str]]) -> str:
    """A repository whose mainline holds one merge per (PR number, branch), in list order."""
    _git(tmp, "init", "-q", "-b", "main")
    _git(tmp, "config", "user.email", "selftest@example.invalid")
    _git(tmp, "config", "user.name", "selftest")
    open(os.path.join(tmp, "seed"), "w").write("seed\n")
    _git(tmp, "add", "seed")
    _git(tmp, "commit", "-q", "-m", "seed")
    for pr, branch in merges:
        _git(tmp, "checkout", "-q", "-b", branch)
        open(os.path.join(tmp, branch.replace("/", "_")), "w").write("x\n")
        _git(tmp, "add", "-A")
        _git(tmp, "commit", "-q", "-m", "work on " + branch)
        _git(tmp, "checkout", "-q", "main")
        _git(tmp, "merge", "-q", "--no-ff", "-m",
             "Merge pull request #%d from ns/%s" % (pr, branch), branch)
    return tmp


def _write(tmp: str, entry_branches: list[str], mangle=None) -> str:
    body = ENTRIES_MARKER + "\n\n" + "\n".join(GOOD_ENTRY % b for b in entry_branches)
    if mangle:
        body = mangle(body)
    path = os.path.join(tmp, "changelog.md")
    open(path, "w", encoding="utf-8").write("# fixture\n\n" + body)
    return path


def selftest() -> int:
    # Mainline order: PR #3 .. #5 (the oldest-first era), then the boundary, then #51 .. #53.
    merges = [(3, "old/a"), (4, "old/b"), (5, "old/c"), (50, ERA_BOUNDARY),
              (51, "new/a"), (52, "new/b"), (53, "new/c")]
    # In-file order: newest-first down to the boundary, then oldest-first below it.
    good = ["new/c", "new/b", "new/a", ERA_BOUNDARY, "old/a", "old/b", "old/c"]

    cases: list[tuple[str, object, object, str]] = []

    def case(name, entry_branches, mangle, expect):
        cases.append((name, entry_branches, mangle, expect))

    case("a file in order passes", good, None, "")
    case("a newest-first entry out of order is caught",
         ["new/b", "new/c", "new/a", ERA_BOUNDARY, "old/a", "old/b", "old/c"], None,
         "belongs above")
    case("an oldest-first entry out of order is caught",
         ["new/c", "new/b", "new/a", ERA_BOUNDARY, "old/b", "old/a", "old/c"], None,
         "oldest-first")
    case("an entry appended at the file's end is caught",
         ["new/c", "new/b", ERA_BOUNDARY, "old/a", "old/b", "old/c", "new/a"], None,
         "not appended at its end")
    case("the branch's own unmerged entry, written first, passes",
         ["this/branch"] + good, None, "")
    case("an unmerged entry that is not the first is caught",
         good + ["never/merged"], None, "matches no 'Merge pull request")
    case("a bodiless heading is caught", good,
         lambda b: b.replace("### Branch: new/b", "### Branch: stray/heading\n\n### Branch: new/b"),
         "has 0 'Status:' lines")
    case("a heading glued to the previous line by a lost newline is caught", good,
         lambda b: b.replace("body\n\n### Branch: new/b", "body### Branch: new/b"),
         "has 2 'Status:' lines")
    case("the era boundary going missing stops the check rather than passing it",
         [b for b in good if b != ERA_BOUNDARY], None,
         "era boundary")

    with tempfile.TemporaryDirectory() as tmp:
        repo = _fixture_repo(os.path.join(tmp, "repo") if os.makedirs(
            os.path.join(tmp, "repo"), exist_ok=True) is None else tmp, merges)
        failures = 0
        for name, entry_branches, mangle, expect in cases:
            path = _write(tmp, entry_branches, mangle)
            try:
                findings = check(path, repo)
            except Unmeasurable as exc:
                print("  FAIL  %s — the check refused to measure: %s" % (name, exc))
                failures += 1
                continue
            if expect == "":
                ok = not findings
            else:
                ok = any(expect in f for f in findings)
            print("  %s  %s" % ("ok  " if ok else "FAIL", name))
            if not ok:
                failures += 1
                for f in findings:
                    print("        got: " + f)
                if expect:
                    print("        expected a finding containing: " + expect)

        # `check <path>` must actually read that path. An argument silently ignored would
        # check the repository's own changelog — here the fixture's, which does not exist — and
        # never report the findings of the file it was handed; a finding count quoted as
        # evidence would then be a measurement of the wrong file. Run through the real command
        # line, not through check(), and inside the fixture rather than this checkout: this
        # checkout's own `main` and `origin/main` can legitimately have diverged, which is a
        # refusal (exit 1), and this arm is not about which mainline gets read.
        bad = _write(tmp, ["new/b", "new/c", "new/a", ERA_BOUNDARY, "old/a", "old/b", "old/c"])
        proc = subprocess.run([sys.executable, os.path.abspath(__file__), "check", bad],
                              capture_output=True, text=True, cwd=repo)
        # Not "new/b" alone: that is the fixture's first entry, which this check deliberately
        # exempts from needing a merge. The ordering finding names both.
        named = os.path.basename(bad) in proc.stdout and "new/c" in proc.stdout
        if proc.returncode == 2 and named:
            print("  ok    `check <path>` reads the path it is given")
        else:
            print("  FAIL  `check <path>` did not read the path it is given "
                  "(exit %d, named=%s)" % (proc.returncode, named))
            failures += 1

        # A refusal rather than a clean zero, proved rather than asserted.
        empty = os.path.join(tmp, "empty.md")
        open(empty, "w").write("# nothing here\n")
        for name, path, cwd in (("a file with no '## Entries' refuses", empty, repo),
                                ("a directory that is not a repository refuses",
                                 _write(tmp, good), tempfile.gettempdir())):
            try:
                check(path, cwd)
            except Unmeasurable as exc:
                print("  ok    %s (%s)" % (name, str(exc).split("\n")[0][:60]))
            else:
                print("  FAIL  %s — it returned an answer instead" % name)
                failures += 1
        ran = len(cases) + 3

        # Which mainline is read (SONNY-480). Every worktree shares one local `main`, and nothing
        # moves it when a pull request merges on GitHub, so between a merge and somebody's pull
        # it names a commit from before that merge while `origin/main` already holds it. Read
        # first, a stale `main` reports every entry merged since as unmerged — a false finding
        # that reads exactly like a real one, and the stop hook blocks a turn on it.
        # tip is #53's merge; tip~2 is #51's, the last merge a stale `main` would still hold.
        tip = _git(repo, "rev-parse", "main")
        behind = _git(repo, "rev-parse", "main~2")
        # A commit on `main` that `origin/main` does not hold, and the reverse: diverged.
        stray = _git(repo, "commit-tree", behind + "^{tree}", "-p", behind, "-m", "local only")
        # (name, local main, origin/main, the ref that must be read or None for a refusal,
        #  what the note or the refusal must say)
        refs_cases = [
            ("a local main behind origin/main is not what gets measured",
             behind, tip, "origin/main", ["local main at %s" % behind[:8], "2 first-parent"]),
            ("a local main ahead of origin/main is what gets measured",
             tip, behind, "main", ["origin/main at %s" % behind[:8], "2 first-parent"]),
            ("main and origin/main at one commit measure clean",
             tip, tip, "main", ["the same commit"]),
            ("origin/main alone, with no local main, is measured",
             None, tip, "origin/main", ["no local main"]),
            ("a local main diverged from origin/main refuses rather than picking one",
             stray, tip, None, ["have diverged", stray[:8], tip[:8]]),
        ]
        for name, main_sha, origin_sha, want_ref, says in refs_cases:
            _point_mainline_refs(repo, main_sha, origin_sha)
            path = _write(tmp, good)
            ran += 1
            try:
                mainline = resolve_mainline(repo)
                findings = check(path, repo, mainline)
            except Unmeasurable as exc:
                text = str(exc)
                ok = want_ref is None and all(w in text for w in says)
                detail = "refused: %s" % text
            else:
                ok = (want_ref == mainline.ref and mainline.sha == (
                          origin_sha if want_ref == "origin/main" else main_sha)
                      and not findings and all(w in mainline.note for w in says))
                detail = "read %s; %s" % (mainline.line(),
                                          "; ".join(findings) or "measured clean")
            print("  %s  %s" % ("ok  " if ok else "FAIL", name))
            if not ok:
                failures += 1
                print("        got: " + detail)
                print("        expected: %s, saying %s" % (want_ref or "a refusal", says))

        # The mainline and its SHA are printed on every run, through the real command line —
        # a reading that does not say what it read cannot be told apart from a stale one. And a
        # refusal puts its reason first, because the stop hook keeps only the head of it.
        _point_mainline_refs(repo, behind, tip)
        proc = subprocess.run([sys.executable, os.path.abspath(__file__), "check",
                               _write(tmp, good)], capture_output=True, text=True, cwd=repo)
        want = "changelog-order: mainline is origin/main at %s — local main at %s" % (
            tip[:8], behind[:8])
        ran += 1
        if proc.returncode == 0 and want in proc.stdout:
            print("  ok    a clean run prints the mainline it read and its SHA")
        else:
            print("  FAIL  a clean run did not print %r (exit %d)\n        got: %s"
                  % (want, proc.returncode, (proc.stdout + proc.stderr).strip()))
            failures += 1
        _point_mainline_refs(repo, stray, tip)
        proc = subprocess.run([sys.executable, os.path.abspath(__file__), "check",
                               _write(tmp, good)], capture_output=True, text=True, cwd=repo)
        first = (proc.stderr.splitlines() or [""])[0]
        ran += 1
        if proc.returncode == 1 and "have diverged" in first and proc.stdout == "":
            print("  ok    a diverged mainline exits 1 with its reason on the first line")
        else:
            print("  FAIL  a diverged mainline did not refuse cleanly (exit %d)\n        got: %s"
                  % (proc.returncode, (proc.stdout + proc.stderr).strip()))
            failures += 1
        # A refusal that comes after the mainline resolved still names it — on the line after
        # the reason, never before it.
        _point_mainline_refs(repo, tip, None)
        proc = subprocess.run([sys.executable, os.path.abspath(__file__), "check", empty],
                              capture_output=True, text=True, cwd=repo)
        lines = proc.stderr.splitlines()
        ran += 1
        if (proc.returncode == 1 and len(lines) == 2 and "## Entries" in lines[0]
                and lines[1].startswith("changelog-order: mainline is main at %s" % tip[:8])):
            print("  ok    a refusal after the mainline resolved gives its reason, then the "
                  "mainline")
        else:
            print("  FAIL  a refusal after the mainline resolved was not reason-then-mainline "
                  "(exit %d)\n        got: %s" % (proc.returncode, proc.stderr.strip()))
            failures += 1

    print("selftest: %d case(s), %d failure(s)" % (ran, failures))
    return 0 if failures == 0 else 2


def main(argv: list[str]) -> int:
    args = [a for a in argv[1:] if not a.startswith("-")]
    if args and args[0] == "selftest":
        return selftest()
    if args and args[0] not in ("check",):
        print(__doc__)
        return 0 if args[0] in ("help", "--help") else 1
    mainline = None
    try:
        root = repo_root()
        # `check <path>` reads some other copy of the file — an older tree written out with
        # `git show`, most usefully — against this repository's merge log. The default is the
        # working tree's own. Ordering is a property of the file *and* the mainline, so the
        # log always comes from the repository this is run in.
        path = os.path.abspath(args[1]) if len(args) > 1 else os.path.join(root, CHANGELOG)
        mainline = resolve_mainline(root)
        findings = check(path, root, mainline)
    except Unmeasurable as exc:
        # The reason first: the stop hook quotes a refusal only as far as `cut -c1-200` reaches.
        print("changelog-order: no measurement was made — %s" % exc, file=sys.stderr)
        if mainline is not None:
            print(mainline.line(), file=sys.stderr)
        return 1
    print(mainline.line())
    if findings:
        for f in findings:
            print(f)
        print("\n%d finding(s). The changelog's Entry Template preamble states where an entry "
              "goes and why the file has two eras." % len(findings), file=sys.stderr)
        return 2
    shown = os.path.relpath(path, root) if path.startswith(root) else path
    print("changelog-order: %s is in merge order, %d entries, both eras."
          % (shown, len(entries(open(path, encoding='utf-8').read()))))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
