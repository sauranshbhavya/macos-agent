  st_eq "one survivor in each half exits 2" "$ST_RC" "2"
  st_contains "the server plan's block names its half" "$ST_OUT" "suite      : server — MUTATE_ALL_SERVER_TEST_CMD"
  st_contains "the Swift plan's block names its half" "$ST_OUT" "suite      : swift — MUTATE_ALL_SWIFT_TEST_CMD"
  st_eq "each plan killed one and kept one" "$(st_count "$ST_OUT" '^    RAN — 1 killed, 1 survived, 0 unattributed ')" "2"
  st_eq "the Swift survivor is one row, marked swift" \
    "$(st_count "$ST_OUT" '^      plan mutation/plans/swift-half\.txt +swift +S2 +sample\.swift')" "1"
  st_eq "the server survivor is one row, marked server" \
    "$(st_count "$ST_OUT" '^      plan mutation/plans/server-half\.txt +server +V2 +(\./)?server/src/sample\.ts')" "1"
  st_eq "no killed mutant is listed as a survivor" "$(st_count "$ST_OUT" '^      plan .* (S1|V1) ')" "0"
  st_contains "the reports list marks the server plan" "$ST_OUT" "server  mutation/plans/server-half.txt ->"
  st_contains "the reports list marks the Swift plan" "$ST_OUT" "swift   mutation/plans/swift-half.txt ->"
  st_contains "a server plan run with DATABASE_URL set says so" "$ST_OUT" "DATABASE_URL is set (its value is not printed)"
  st_eq "the Swift suite never ran with a server mutant in the tree" "$(st_count "$suites" '^swift saw:.*server-')" "0"
  st_eq "vitest never ran with a Swift mutant in the tree" "$(st_count "$suites" '^server saw:.*swift-')" "0"
  st_eq "the Swift suite did see its own mutant (the zero above can be non-zero)" \
    "$([[ $(st_count "$suites" '^swift saw:.*swift-mutant') -ge 1 ]] && echo yes || echo no)" "yes"
  st_eq "vitest did see its own mutant" \
    "$([[ $(st_count "$suites" '^server saw:.*server-mutant') -ge 1 ]] && echo yes || echo no)" "yes"
  if [[ -n "$logdir" && -f "$logdir/server-half.log" && -f "$logdir/swift-half.log" ]]; then
    st_contains "the server kill is attributed to the vitest test, by file and describe block" \
      "$(cat "$logdir/server-half.log")" "test/sample.test.ts > the tier limit > gives the free tier ten"
    st_absent "and not to the Swift test" "$(cat "$logdir/server-half.log")" "labelIsMorningBeforeNoon"
    st_contains "the Swift kill is attributed to the Swift test" \
      "$(cat "$logdir/swift-half.log")" "labelIsMorningBeforeNoon()"
    st_absent "and not to the vitest test" "$(cat "$logdir/swift-half.log")" "the tier limit"
