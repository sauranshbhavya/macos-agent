  git rm -q mutation/plans/fix/some-name.txt
  git commit -q -m "clear plans for the next scenario"

  # --- The two halves (SONNY-455) ---
  # Each half's stand-in appends one line per run to a log OUTSIDE the throwaway repository — a
  # file inside it would be untracked, which scripts/mutate reads as a dirty tree mid-battery —
  # naming its own half and every planted mutant it found in the tree while it ran. That log is
  # what says which suite saw which mutant; the report alone could be right by accident.
  export ST_SUITES_LOG="$SELFTEST_ROOT/suites.log"
  local st_seen='seen=""
grep -q "hour < 13" sample.swift && seen="$seen swift-mutant"
grep -q "Never" sample.swift && seen="$seen swift-survivor"
grep -q "return 11;" server/src/sample.ts && seen="$seen server-mutant"
grep -q "return 999;" server/src/sample.ts && seen="$seen server-survivor"
grep -q "hour < 14" sample.swift && seen="$seen mixed-plan-mutant"
grep -q "return 12;" server/src/sample.ts && seen="$seen mixed-plan-mutant"
'
  local swift_half_suite="# swift test --scratch-path \"\$MUTATE_SCRATCH\"
$st_seen"'printf "swift saw:%s\n" "${seen:- nothing}" >>"$ST_SUITES_LOG"
printf "◇  Test run started.\n"
if grep -q "hour < 13" sample.swift || grep -q ">>> file moved" notes.txt; then
  printf "✘  Test labelIsMorningBeforeNoon() failed after 0.001 seconds with 1 issue.\n"
  printf "✘  Test run with 2 tests in 1 suite failed after 0.001 seconds with 1 issue.\n"
  exit 1
fi
printf "✔  Test run with 2 tests in 1 suite passed after 0.001 seconds.\n"'
  # vitest's shapes, the same ones `scripts/mutate selftest` copied out of real runs of this
  # repository's server suite, and it cds into server/ first, as the real default does.
  local server_half_suite="$st_seen"'printf "server saw:%s\n" "${seen:- nothing}" >>"$ST_SUITES_LOG"
cd server || exit 1
printf " RUN  v4.1.11 /repo/server\n"
if grep -q "return 11;" src/sample.ts; then
  printf " ❯ test/sample.test.ts (2 tests | 1 failed) 3ms\n"
  printf "     × gives the free tier ten 1ms\n"
  printf "⎯⎯⎯⎯⎯⎯⎯ Failed Tests 1 ⎯⎯⎯⎯⎯⎯⎯\n"
  printf " FAIL  test/sample.test.ts > the tier limit > gives the free tier ten\n"
  printf "AssertionError: expected 11 to be 10 // Object.is equality\n"
  printf "⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯⎯[1/1]⎯\n"
  printf " Test Files  1 failed (1)\n"
  printf "      Tests  1 failed | 1 passed (2)\n"
  exit 1
fi
printf " Test Files  1 passed (1)\n"
printf "      Tests  2 passed (2)\n"'

  # --- Scenario 11: one Swift plan and one server plan, each against its own suite, each with a
  # deliberate survivor — the ticket's acceptance shape ---
  printf '\n==> A Swift plan runs the Swift suite and a server plan runs vitest, each with its own survivor\n'
  cat >mutation/plans/server-half.txt <<'PLAN'
