  st_absent "it is not refused as mixed" "$ST_OUT" "REFUSED"

  # --- Scenario 17: MUTATE_TEST_CMD over every plan is refused before anything runs ---
  printf '\n==> MUTATE_TEST_CMD is refused, and no plan is attempted\n'
  ST_RC=0
  ST_OUT="$(MUTATE_TEST_CMD='printf "one command for every plan\n"' "$SELF" 2>&1)" || ST_RC=$?
  st_eq "MUTATE_TEST_CMD exits 1" "$ST_RC" "1"
  st_contains "the refusal names the variable" "$ST_OUT" "MUTATE_TEST_CMD is set"
  st_contains "and the per-half replacements" "$ST_OUT" "MUTATE_ALL_SERVER_TEST_CMD"
  st_absent "no plan was attempted" "$ST_OUT" "==> [1/"
  git rm -q mutation/plans/quotes-a-directive.txt
  git commit -q -m "clear plans for the next scenario"

  # --- Scenario 18: a server path in a spelling git normalises is still the server half (PR #239's
  # review, F2). Each spelling is one plan with one mutant only vitest kills; a prefix test on the
  # written string sends the `..` and absolute ones to the Swift suite, where the mutant survives. ---
  printf '\n==> Server paths spelled with .., an absolute path or a doubled slash still run vitest\n'
  cat >mutation/plans/spelled-dotdot.txt <<'PLAN'
>>> mutant V1 the free tier given one more
>>> file scripts/../server/src/sample.ts
>>> from
  if (tier === "free") return 10;
>>> to
  if (tier === "free") return 11;
>>> end
PLAN
  cat >mutation/plans/spelled-absolute.txt <<PLAN
>>> mutant V1 the free tier given one more
>>> file $root/server/src/sample.ts
>>> from
  if (tier === "free") return 10;
>>> to
  if (tier === "free") return 11;
>>> end
PLAN
  cat >mutation/plans/spelled-double-slash.txt <<'PLAN'
>>> mutant V1 the free tier given one more
>>> file server//src/sample.ts
>>> from
  if (tier === "free") return 10;
>>> to
  if (tier === "free") return 11;
>>> end
PLAN
  git add mutation/plans/spelled-dotdot.txt mutation/plans/spelled-absolute.txt mutation/plans/spelled-double-slash.txt
  git commit -q -m "one server plan per unusual spelling"
  export DATABASE_URL='postgres://selftest:not-a-real-password-8c1f@localhost:1/none'
  : >"$ST_SUITES_LOG"
  st_run "$swift_half_suite" "$server_half_suite"
  unset DATABASE_URL
  suites="$(cat "$ST_SUITES_LOG")"
  st_eq "every spelling's mutant is killed" "$ST_RC" "0"
  st_eq "all three plans are the server half" "$(st_count "$ST_OUT" '^    suite      : server ')" "3"
  st_eq "none is the Swift half" "$(st_count "$ST_OUT" '^    suite      : swift ')" "0"
  st_eq "each killed its one mutant" "$(st_count "$ST_OUT" '^    RAN — 1 killed, 0 survived, 0 unattributed ')" "3"
  st_eq "the Swift suite never ran with the server mutant applied" "$(st_count "$suites" '^swift saw:.*server-mutant')" "0"
  st_eq "vitest ran with it once per plan at least" \
    "$([[ $(st_count "$suites" '^server saw:.*server-mutant') -ge 3 ]] && echo yes || echo no)" "yes"
  git rm -q mutation/plans/spelled-dotdot.txt mutation/plans/spelled-absolute.txt mutation/plans/spelled-double-slash.txt
  git commit -q -m "clear plans for the next scenario"

  # --- Scenario 19: the other direction — a Swift file whose written path starts with server/ ---
  printf '\n==> A Swift path spelled server/../sample.swift is the Swift half, not the server one\n'
  cat >mutation/plans/spelled-through-server.txt <<'PLAN'
>>> mutant S1 the morning boundary widened by an hour
>>> file server/../sample.swift
>>> from
        if hour < 12 { return "Morning" }
>>> to
        if hour < 13 { return "Morning" }
>>> end
PLAN
  git add mutation/plans/spelled-through-server.txt
  git commit -q -m "a Swift plan spelled through server/"
  : >"$ST_SUITES_LOG"
  st_run "$swift_half_suite" "$server_half_suite"
  suites="$(cat "$ST_SUITES_LOG")"
  st_eq "its mutant is killed by the Swift suite" "$ST_RC" "0"
  st_contains "its block names the Swift half" "$ST_OUT" "suite      : swift"
  st_absent "not the server half" "$ST_OUT" "suite      : server"
  st_eq "vitest never ran" "$(st_count "$suites" '^server saw:')" "0"
  git rm -q mutation/plans/spelled-through-server.txt
  git commit -q -m "clear plans for the next scenario"

  # --- Scenario 20: a mixed plan whose server path hides behind a .. spelling is still refused ---
  printf '\n==> A plan mixing the halves through a .. spelling is still refused by name\n'
  cat >mutation/plans/spelled-mixed.txt <<'PLAN'
>>> mutant X1 a Swift mutant
>>> file sample.swift
>>> from
        if hour < 12 { return "Morning" }
>>> to
        if hour < 14 { return "Morning" }
>>> end

>>> mutant X2 a server mutant, its path spelled through scripts/
>>> file scripts/../server/src/sample.ts
>>> from
  if (tier === "free") return 10;
>>> to
  if (tier === "free") return 12;
>>> end
PLAN
  git add mutation/plans/spelled-mixed.txt
  git commit -q -m "a mixed plan hiding its server path"
  : >"$ST_SUITES_LOG"
  st_run "$swift_half_suite" "$server_half_suite"
  suites="$(cat "$ST_SUITES_LOG")"
  st_eq "the refused plan exits 3" "$ST_RC" "3"
  st_contains "it is refused as mixed" "$ST_OUT" "suite      : none — REFUSED: this plan has mutants in both halves"
  st_eq "its server mutant is listed as the server half, in the spelling the plan wrote" \
    "$(st_count "$ST_OUT" '^      server +X2 +scripts/\.\./server/src/sample\.ts$')" "1"
  st_eq "no suite ever ran with its mutants applied" "$(st_count "$suites" 'mixed-plan-mutant')" "0"

  printf '\n'
  if [[ $SELFTEST_FAILURES -eq 0 ]]; then
    printf '==> selftest: all checks passed.\n'
    exit 0
  fi
  printf '==> selftest: %d check(s) FAILED.\n' "$SELFTEST_FAILURES" >&2
  exit 1
}

# ---------------------------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------------------------
case "${1:-}" in
  -h|--help|help)
    usage
    exit 0
    ;;
  selftest)
    [[ $# -eq 1 ]] || die "selftest takes no arguments"
    selftest
    ;;
  "")
    ;;
  *)
    die "unknown argument: $1 (try --help)"
    ;;
esac

# One command over every plan is the defect SONNY-455 closed, so it is refused rather than passed
# through: under a vitest MUTATE_TEST_CMD every Swift plan's mutants read SURVIVED, and under a
# Swift one every server plan's do. scripts/mutate reads an empty value as unset, and so does this.
if [[ -n "${MUTATE_TEST_CMD:-}" ]]; then
  die "refusing to run — MUTATE_TEST_CMD is set, and it would replace the suite for every plan.
  Each plan's suite is chosen from its own >>> file paths: server/ runs vitest, anything else the
  flagged swift test. Unset MUTATE_TEST_CMD, or replace one half's command with
  MUTATE_ALL_SWIFT_TEST_CMD or MUTATE_ALL_SERVER_TEST_CMD. Nothing was run."
fi

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not a git checkout"
cd "$ROOT"
[[ -d mutation/plans ]] || die "mutation/plans/ is missing — nothing to run"
[[ -x "$MUTATE" ]] || die "scripts/mutate not found (or not executable) beside this script at $MUTATE"

SHA="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
stamp="$(date +%Y%m%dT%H%M%S)"
if git check-ignore -q ".build/mutate-all" 2>/dev/null; then
  LOGDIR=".build/mutate-all/${SHA:0:7}-$stamp-$$"
else
  LOGDIR="$(mktemp -d "${TMPDIR:-/tmp}/mutate-all-logs.XXXXXX")"
fi
mkdir -p "$LOGDIR"
SUMMARY_LOG="$LOGDIR/summary.log"

rc=0
{ run_all_plans; } 2>&1 | tee -a "$SUMMARY_LOG" || rc=$?
exit "$rc"
