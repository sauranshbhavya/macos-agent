  # A server plan runs only with DATABASE_URL set (scenario 13b is the unset side), so scenarios 11
  # to 13 plant one. It points nowhere and carries a password-shaped string scenario 13 hunts for.
  export DATABASE_URL='postgres://selftest:not-a-real-password-8c1f@localhost:1/none'
  : >"$ST_SUITES_LOG"
  st_run "$swift_half_suite" "$server_half_suite"
  local suites logdir
  suites="$(cat "$ST_SUITES_LOG")"
