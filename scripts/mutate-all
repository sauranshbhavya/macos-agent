  else
    st_fail "could not find the logs directory the header printed"
  fi
  git rm -q mutation/plans/server-half.txt mutation/plans/swift-half.txt
  git commit -q -m "clear plans for the next scenario"

  # --- Scenario 13b: DATABASE_URL unset — a server plan is checked, then skipped by name, never
