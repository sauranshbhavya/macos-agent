#!/usr/bin/env python3
"""Derive `LatinConfusables.table` from UTS #39's confusables.txt (SONNY-272).

Usage:
  scripts/confusables-table <confusables.txt>            print the Swift table lines
  scripts/confusables-table <confusables.txt> --write    replace the generated block in
                                                          Sources/MacAgentCore/LatinConfusables.swift
  scripts/confusables-table <confusables.txt> --check    exit 2 if that block is not what the
                                                          data file produces

The data file is https://www.unicode.org/Public/security/latest/confusables.txt and is not kept in
this repository; the Swift file's header records the version and date of the copy the table was
generated from.

The rule, which the Swift file's doc comment states in prose and this script is the executable form
of — change one and the other, and `LatinConfusablesTests` holds the parts of it a test can hold:

  a scalar is in the table when
    1. it is not ASCII,
    2. UTS #39 maps it to exactly ONE scalar,
    3. that scalar is an ASCII letter (A-Z or a-z),
    4. the source scalar is a letter — general category L* — so no digit, symbol or mark of any
       script is folded, whatever UTS #39 says it looks like (Arabic-Indic digit one looks like l;
       a digit stays a digit here), and
    5. the source scalar lies in a block of a script that Vision's accurate recognizer can emit —
       the scripts its supported recognition languages are written in on macOS 25.5.0
       (`VNRecognizeTextRequest.supportedRecognitionLanguages()`): Latin outside ASCII, Cyrillic,
       Arabic, Thai, Han, Kana and Hangul. Greek, the mathematical alphanumerics, Cherokee,
       Armenian and the rest of the table's look-alikes are left out on purpose: Vision cannot
       produce them, and a table that folded them would be describing adversarial text, which is
       the untrusted-content boundary's problem and deliberately not this one.

    6. an uppercase source (general category Lu) that UTS #39 sends to `l` folds to `I` instead
       (PR #116 review, F1). UTS #39 merges I, l and 1 into one confusable class whose prototype is
       `l` — it is a spoofing table, and for spoofing the three are the same — which throws away
       the case the recognizer preserved when it emitted a capital letter. Three entries: U+0196
       LATIN CAPITAL LETTER IOTA, U+0406 CYRILLIC CAPITAL LETTER BYELORUSSIAN-UKRAINIAN I and
       U+04C0 CYRILLIC LETTER PALOCHKA. It is the only class where the prototype's case disagrees
       with the glyph's: the two capitals that map to `b` (U+0184, U+042C) look like a lowercase b.

  The fullwidth Latin letters (U+FF21-U+FF3A, U+FF41-U+FF5A), which CJK text writes Latin in, are
  NOT taken from UTS #39 and are not in this table: `LatinConfusables.fold` folds all fifty-two by
  arithmetic, because each one is its ASCII letter by Unicode's compatibility decomposition — a
  definition, not a look-alike judgement — and UTS #39 covers only thirty-one of them and sends
  fullwidth I to `l`. Everything else in the Halfwidth and Fullwidth Forms block is left alone.

  Rule 4 reads a scalar's general category from the running Python's Unicode database, which is
  older than the data file on every Python this repository has met (13.0.0 against 17.0.0). That
  can only matter for a candidate the older database has not assigned yet — its category reads as
  Cn and rule 4 would drop it silently — so the script counts those and REFUSES to emit a table
  while any exist, prints the database version it used in every mode, and records it in the
  generated header; `LatinConfusablesTests` re-checks rule 4 with the platform's own Unicode
  tables, which is the check that actually holds. `--check` compares the entries and the data
  file's version and ignores the provenance line, so a different Python does not read as a
  different table.
"""
import re
import sys
import unicodedata
from pathlib import Path

SWIFT_FILE = Path(__file__).resolve().parent.parent / "Sources" / "MacAgentCore" / "LatinConfusables.swift"
BEGIN = "    // BEGIN generated by scripts/confusables-table — do not edit by hand"
END = "    // END generated by scripts/confusables-table"

# Rule 5: the blocks. Named so the Swift test that pins the same rule can be read against this list.
BLOCKS = [
    ("Latin-1 Supplement", 0x00A0, 0x00FF),
    ("Latin Extended-A", 0x0100, 0x017F),
    ("Latin Extended-B", 0x0180, 0x024F),
    ("IPA Extensions", 0x0250, 0x02AF),
    ("Latin Extended Additional", 0x1E00, 0x1EFF),
    ("Latin Extended-C", 0x2C60, 0x2C7F),
    ("Latin Extended-D", 0xA720, 0xA7FF),
    ("Latin Extended-E", 0xAB30, 0xAB6F),
    ("Cyrillic", 0x0400, 0x04FF),
    ("Cyrillic Supplement", 0x0500, 0x052F),
    ("Cyrillic Extended-C", 0x1C80, 0x1C8F),
    ("Cyrillic Extended-A", 0x2DE0, 0x2DFF),
    ("Cyrillic Extended-B", 0xA640, 0xA69F),
    ("Cyrillic Extended-D", 0x1E030, 0x1E08F),
    ("Arabic", 0x0600, 0x06FF),
    ("Arabic Supplement", 0x0750, 0x077F),
    ("Arabic Extended-A", 0x08A0, 0x08FF),
    ("Arabic Presentation Forms-A", 0xFB50, 0xFDFF),
    ("Arabic Presentation Forms-B", 0xFE70, 0xFEFF),
    ("Thai", 0x0E00, 0x0E7F),
    ("Hangul Jamo", 0x1100, 0x11FF),
    ("CJK Radicals Supplement", 0x2E80, 0x2EFF),
    ("Kangxi Radicals", 0x2F00, 0x2FDF),
    ("CJK Symbols and Punctuation", 0x3000, 0x303F),
    ("Hiragana", 0x3040, 0x309F),
    ("Katakana", 0x30A0, 0x30FF),
    ("Bopomofo", 0x3100, 0x312F),
    ("Hangul Compatibility Jamo", 0x3130, 0x318F),
    ("CJK Strokes", 0x31C0, 0x31EF),
    ("Katakana Phonetic Extensions", 0x31F0, 0x31FF),
    ("CJK Unified Ideographs Extension A", 0x3400, 0x4DBF),
    ("CJK Unified Ideographs", 0x4E00, 0x9FFF),
    ("Hangul Syllables", 0xAC00, 0xD7AF),
    ("CJK Compatibility Ideographs", 0xF900, 0xFAFF),
    ("CJK Unified Ideographs Extensions B-I", 0x20000, 0x323AF),
]


def block_of(codepoint):
    for name, low, high in BLOCKS:
        if low <= codepoint <= high:
            return name
    return None


def parse(path):
    version = date = None
    entries = []
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            if line.startswith("# Version:"):
                version = line.split(":", 1)[1].strip()
            elif line.startswith("# Date:"):
                date = line.split(":", 1)[1].strip().split(",")[0]
            stripped = line.strip()
            if not stripped or stripped.startswith("#"):
                continue
            fields = [field.strip() for field in stripped.split(";")]
            source = int(fields[0], 16)
            targets = [int(hexcode, 16) for hexcode in fields[1].split()]
            entries.append((source, targets))
    if version is None or date is None:
        sys.exit("not a confusables.txt: no '# Version:' / '# Date:' header")
    return version, date, entries


def select(entries):
    """Rows (source, target, block) plus the count of in-block candidates rule 4 was asked about."""
    rows = []
    candidates = 0
    unassigned = []
    for source, targets in entries:
        if source < 0x80:  # 1
            continue
        if len(targets) != 1:  # 2
            continue
        target = targets[0]
        if not (0x41 <= target <= 0x5A or 0x61 <= target <= 0x7A):  # 3
            continue
        block = block_of(source)
        if block is None:  # 5, checked ahead of 4 so the candidate count is the in-block population
            continue
        candidates += 1
        category = unicodedata.category(chr(source))
        if category == "Cn":
            unassigned.append(source)
            continue
        if not category.startswith("L"):  # 4
            continue
        if target == 0x6C and category == "Lu":  # 6
            target = 0x49
        rows.append((source, target, block))
    if unassigned:
        listed = ", ".join(f"U+{cp:04X}" for cp in unassigned)
        sys.exit(f"refusing: this Python's Unicode database ({unicodedata.unidata_version}) has not assigned "
                 f"{len(unassigned)} candidate scalar(s) the data file knows — {listed} — so rule 4 cannot be "
                 f"evaluated for them; run with a newer Python")
    rows.sort()
    return rows, candidates


PROVENANCE_PREFIX = "    // Rule 4's general categories came from the generating Python's Unicode "


def provenance(candidates):
    return (f"{PROVENANCE_PREFIX}{unicodedata.unidata_version} database (0 of {candidates} in-block "
            "candidates unassigned there); LatinConfusablesTests re-checks rule 4 with the platform's own.")


def render(version, date, rows, candidates):
    lines = [BEGIN,
             f"    // Unicode {version} confusables.txt dated {date}; {len(rows)} entries.",
             provenance(candidates),
             "    static let table: [UInt32: UInt8] = ["]
    for source, target, block in rows:
        name = unicodedata.name(chr(source), "?")
        lines.append(f"        0x{source:04X}: 0x{target:02X}, // {name} -> {chr(target)}")
    lines.append("    ]")
    lines.append(END)
    return "\n".join(lines)


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0
    version, date, entries = parse(argv[1])
    rows, candidates = select(entries)
    block = render(version, date, rows, candidates)
    print(f"confusables-table: rule 4 evaluated with Unicode {unicodedata.unidata_version} "
          f"(Python {sys.version.split()[0]}); {candidates} in-block candidates, {len(rows)} entries",
          file=sys.stderr)
    mode = argv[2] if len(argv) > 2 else None
    if mode is None:
        print(block)
        return 0
    source = SWIFT_FILE.read_text(encoding="utf-8")
    pattern = re.compile(re.escape(BEGIN) + r".*?" + re.escape(END), re.DOTALL)
    if not pattern.search(source):
        sys.exit(f"{SWIFT_FILE} carries no generated block to replace")
    updated = pattern.sub(lambda _: block, source, count=1)
    if mode == "--check":
        without_provenance = re.compile(re.escape(PROVENANCE_PREFIX) + r"[^\n]*\n")
        if without_provenance.sub("", updated) == without_provenance.sub("", source):
            print(f"{SWIFT_FILE.name}: generated block matches {argv[1]} ({version})")
            return 0
        print(f"{SWIFT_FILE.name}: generated block differs from {argv[1]} ({version})")
        return 2
    if mode == "--write":
        SWIFT_FILE.write_text(updated, encoding="utf-8")
        print(f"{SWIFT_FILE.name}: generated block rewritten from {argv[1]} ({version})")
        return 0
    sys.exit(f"unknown mode {mode}")


if __name__ == "__main__":
    sys.exit(main(sys.argv))
