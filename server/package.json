{
  "name": "sonny-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Sonny's backend gateway. Holds provider credentials, authenticates users, meters usage, and forwards to model providers.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build && cp -R src/db/migrations dist/db/",
    "start": "node dist/server.js",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "migrate": "node dist/db/migrate.js",
    "revocations": "node dist/revocations.js",
    "usage": "node dist/usage.js",
    "support": "node dist/support.js",
    "snapshots": "node dist/snapshots.js",
    "entitlements": "node dist/entitlements.js",
    "check:secrets": "./scripts/check-secrets.sh",
    "test:db": "DATABASE_URL=${DATABASE_URL:-postgres://postgres:postgres@localhost:55433/postgres} vitest run"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
