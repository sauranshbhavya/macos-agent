# Copy to server/.env for local development. server/.env is gitignored and must never be committed.
#
# EVERY VALUE HERE IS A PLACEHOLDER. Real credentials live in the host's own environment
# configuration -- the VM's environment mechanism on deploymind, Oracle or AWS -- and never in a
# file in this repository. `npm run check:secrets` fails the build if a real-looking key appears
# anywhere in the tree, including in this file.

# Which of the three environments this process is. local | staging | production
SONNY_ENV=local

PORT=8080
HOST=0.0.0.0
LOG_LEVEL=debug

# Whether to believe X-Forwarded-For and X-Forwarded-Proto. Leave false unless a proxy or load
# balancer really terminates the connection in front of this container: those headers are
# caller-supplied, so trusting them with nothing in front lets a client choose its own apparent
# IP address -- which matters the moment anything rate-limits or logs by address.
TRUST_PROXY=false

# Surfaced by GET /v1/health as `version`. Injected at image build time in staging and production;
# "dev" locally.
SONNY_BUILD_ID=dev

# Supabase Postgres. Supabase keeps auth and the database under the 2026-08-21 decision.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# ── Provider credentials ─────────────────────────────────────────────────────────────────────
# Two live credentials per provider are supported so one can be retired with no downtime. The
# numbered variables are read in order and stop at the first gap: <PROVIDER>_API_KEY is the
# credential new requests use, _2 and beyond stay accepted through the overlap.
#
# A rotation is three independent deploys, each of which is valid on its own:
#   1. add the new key as OPENAI_API_KEY_2      -- both live, old one still serving
#   2. swap them, new key becomes OPENAI_API_KEY -- new one serving, old one still accepted
#   3. delete OPENAI_API_KEY_2                   -- old one retired
# At no point does the server run without a working credential.
#
# None of these is required to start the server today: this ticket builds no route that calls a
# provider, so the ticket that adds one is where its credential becomes mandatory.

OPENAI_API_KEY=replace-me
OPENAI_API_KEY_2=

ANTHROPIC_API_KEY=replace-me
ANTHROPIC_API_KEY_2=

CEREBRAS_API_KEY=replace-me
CEREBRAS_API_KEY_2=

TAVILY_API_KEY=replace-me
TAVILY_API_KEY_2=

VISION_API_KEY=replace-me
VISION_API_KEY_2=
