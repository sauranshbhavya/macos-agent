# Copy to .env (git-ignored). Keys are read once by src/config.ts and never logged.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
OPENAI_API_KEY=
# OPENAI_BASE_URL=
COORDINATOR_MODEL=gpt-5.6-luna
TEXT_MODEL=gpt-5.5
MAX_ACTIONS=60
MAX_COORDINATOR_TURNS=12
JUDGE=jev              # jev (no coordinator, jev-ultrafast's loop) | coordinator
MIN_OPERATION_CONFIDENCE=0.35   # coordinator mode only
RUNS_DIR=runs
# CUA_DRIVER_BIN=   # defaults to .cua-driver/cua-driver from scripts/fetch-cua-driver.sh
